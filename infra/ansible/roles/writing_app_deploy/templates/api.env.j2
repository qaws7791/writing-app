NODE_ENV=production
DEPLOYMENT_ENVIRONMENT={{ writing_app_environment }}
API_PORT=4000
ENABLE_API_DOCS={{ writing_app_enable_api_docs | bool | lower }}
DATABASE_URL=file:/var/lib/writing-app/api.sqlite
WEB_ORIGIN={{ writing_app_web_origin | to_json }}
ADMIN_ORIGIN={{ writing_app_admin_origin | to_json }}
{% if writing_app_admin_mcp_enabled | bool %}
ADMIN_MCP_ENABLED=true
ADMIN_MCP_RESOURCE_URL={{ ('https://' ~ writing_app_admin_mcp_host ~ '/mcp/admin') | to_json }}
ADMIN_MCP_CHANGES_ENABLED={{ writing_app_admin_mcp_changes_enabled | bool | lower }}
{% if writing_app_admin_mcp_changes_enabled | bool %}
ADMIN_MCP_APPROVAL_TTL_SECONDS={{ writing_app_admin_mcp_approval_ttl_seconds }}
ADMIN_MCP_EXECUTION_LEASE_SECONDS={{ writing_app_admin_mcp_execution_lease_seconds }}
ADMIN_MCP_REQUEST_STATE_SECRET={{ writing_app_admin_mcp_request_state_secret | to_json }}
{% endif %}
{% endif %}
LEARNER_AUTH_SECRET={{ writing_app_learner_auth_secret | to_json }}
CURSOR_SIGNING_SECRET={{ writing_app_cursor_signing_secret | to_json }}
ADMIN_AUTH_SECRET={{ writing_app_admin_auth_secret | to_json }}
GOOGLE_CLIENT_ID={{ writing_app_google_client_id | to_json }}
GOOGLE_CLIENT_SECRET={{ writing_app_google_client_secret | to_json }}
RESEND_API_KEY={{ writing_app_resend_api_key | to_json }}
AUTH_EMAIL_FROM={{ writing_app_auth_email_from | to_json(ensure_ascii=False) }}
{% if writing_app_auth_email_reply_to | length > 0 %}
AUTH_EMAIL_REPLY_TO={{ writing_app_auth_email_reply_to | to_json }}
{% endif %}
ADMIN_ASSET_S3_ENDPOINT={{ writing_app_admin_asset_s3_endpoint | to_json }}
ADMIN_ASSET_S3_REGION={{ writing_app_admin_asset_s3_region | to_json }}
ADMIN_ASSET_S3_BUCKET={{ writing_app_admin_asset_s3_bucket | to_json }}
ADMIN_ASSET_PUBLIC_BASE_URL={{ writing_app_admin_asset_public_base_url | to_json }}
ADMIN_ASSET_S3_ACCESS_KEY={{ writing_app_admin_asset_s3_access_key | to_json }}
ADMIN_ASSET_S3_SECRET_KEY={{ writing_app_admin_asset_s3_secret_key | to_json }}
DELETION_MARKER_S3_ENDPOINT={{ writing_app_deletion_marker_s3_endpoint | to_json }}
DELETION_MARKER_S3_REGION={{ writing_app_deletion_marker_s3_region | to_json }}
DELETION_MARKER_S3_BUCKET={{ writing_app_deletion_marker_s3_bucket | to_json }}
DELETION_MARKER_S3_PREFIX={{ writing_app_deletion_marker_s3_prefix | to_json }}
DELETION_MARKER_S3_ACCESS_KEY={{ writing_app_deletion_marker_s3_access_key | to_json }}
DELETION_MARKER_S3_SECRET_KEY={{ writing_app_deletion_marker_s3_secret_key | to_json }}

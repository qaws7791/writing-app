NODE_ENV=production
API_PORT=4000
DATABASE_URL=file:/var/lib/writing-app/api.sqlite
WEB_ORIGIN={{ writing_app_web_origin | to_json }}
ADMIN_ORIGIN={{ writing_app_admin_origin | to_json }}
BETTER_AUTH_URL={{ writing_app_api_origin | to_json }}
ADMIN_BETTER_AUTH_URL={{ writing_app_admin_api_origin | to_json }}
BETTER_AUTH_SECRET={{ writing_app_better_auth_secret | to_json }}
CURSOR_SIGNING_SECRET={{ writing_app_cursor_signing_secret | to_json }}
ADMIN_BETTER_AUTH_SECRET={{ writing_app_admin_better_auth_secret | to_json }}
LEARNER_API_ALLOWED_HOSTS={{ ([writing_app_api_host, 'api:4000'] | join(',')) | to_json }}
ADMIN_API_ALLOWED_HOSTS={{ ([writing_app_admin_api_host, 'admin-api-unified:4000'] | join(',')) | to_json }}
{% if writing_app_better_auth_cookie_domain | length > 0 %}
BETTER_AUTH_COOKIE_DOMAIN={{ writing_app_better_auth_cookie_domain | to_json }}
{% endif %}
{% if writing_app_admin_better_auth_cookie_domain | length > 0 %}
ADMIN_BETTER_AUTH_COOKIE_DOMAIN={{ writing_app_admin_better_auth_cookie_domain | to_json }}
{% endif %}
ENABLE_TEST_AUTH=false
OPENAI_MODEL={{ writing_app_openai_model | to_json }}
{% if writing_app_google_client_id | length > 0 %}
GOOGLE_CLIENT_ID={{ writing_app_google_client_id | to_json }}
{% endif %}
{% if writing_app_google_client_secret | length > 0 %}
GOOGLE_CLIENT_SECRET={{ writing_app_google_client_secret | to_json }}
{% endif %}
{% if writing_app_openai_api_key | length > 0 %}
OPENAI_API_KEY={{ writing_app_openai_api_key | to_json }}
{% endif %}
ADMIN_ASSET_S3_ENDPOINT={{ writing_app_admin_asset_s3_endpoint | to_json }}
ADMIN_ASSET_S3_REGION={{ writing_app_admin_asset_s3_region | to_json }}
ADMIN_ASSET_S3_BUCKET={{ writing_app_admin_asset_s3_bucket | to_json }}
ADMIN_ASSET_PUBLIC_BASE_URL={{ writing_app_admin_asset_public_base_url | to_json }}
ADMIN_ASSET_S3_ACCESS_KEY={{ writing_app_admin_asset_s3_access_key | to_json }}
ADMIN_ASSET_S3_SECRET_KEY={{ writing_app_admin_asset_s3_secret_key | to_json }}

{
  "name": "@workspace/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#core/*": "./src/*"
  },
  "exports": {
    "./admin": "./src/modules/admin/api/index.ts",
    "./learning": "./src/modules/learning/api/index.ts",
    "./resource-library": "./src/modules/resource-library/api/index.ts"
  },
  "scripts": {
    "lint": "oxlint .",
    "test": "bun --bun ../../node_modules/vitest/vitest.mjs run --config vitest.config.ts",
    "test:watch": "bun --bun ../../node_modules/vitest/vitest.mjs watch --config vitest.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@workspace/contracts": "workspace:*",
    "@workspace/identity": "workspace:*",
    "@workspace/kernel": "workspace:*",
    "@workspace/resource-document": "workspace:*",
    "@workspace/types": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@workspace/typescript-config": "workspace:*",
    "typescript": "catalog:",
    "vite-tsconfig-paths": "catalog:",
    "vitest": "catalog:"
  }
}

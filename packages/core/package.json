{
  "name": "@workspace/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#core/*": "./src/*"
  },
  "exports": {
    "./admin": "./src/modules/admin/api/index.ts",
    "./admin-api-core": "./src/composition/admin-bootstrap.ts",
    "./auth": "./src/modules/auth/api/index.ts",
    "./ai-feedback": "./src/modules/ai-feedback/api/index.ts",
    "./content": "./src/modules/content/api/index.ts",
    "./learner-api-core": "./src/composition/bootstrap.ts",
    "./learning": "./src/modules/learning/api/index.ts",
    "./resource-library": "./src/modules/resource-library/api/index.ts"
  },
  "scripts": {
    "lint": "oxlint .",
    "test": "bun --bun ../../node_modules/vitest/vitest.mjs run --config vitest.config.ts",
    "test:e2e:resource-library-load": "playwright test --config playwright.load.config.ts",
    "test:load:resource-library": "bun load/run-resource-document-sync-load.ts",
    "test:watch": "bun --bun ../../node_modules/vitest/vitest.mjs watch --config vitest.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@workspace/contracts": "workspace:*",
    "@workspace/db": "workspace:*",
    "@workspace/resource-document": "workspace:*",
    "better-auth": "^1.6.13",
    "drizzle-orm": "^0.45.0",
    "openai": "^6.39.0",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/bun": "catalog:",
    "@workspace/config": "workspace:*",
    "@workspace/repository-tooling": "workspace:*",
    "typescript": "5.9.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "catalog:",
    "yjs": "13.6.31"
  }
}

{
  "name": "@workspace/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./admin": "./src/admin/index.ts",
    "./admin/*": "./src/admin/*.ts",
    "./auth": "./src/auth/index.ts",
    "./auth/*": "./src/auth/*.ts",
    "./ai-feedback": "./src/ai-feedback/index.ts",
    "./ai-feedback/*": "./src/ai-feedback/*.ts",
    "./content": "./src/content/index.ts",
    "./content/*": "./src/content/*.ts",
    "./learner-api-core": "./src/learner-api-core.ts",
    "./learning": "./src/learning/index.ts",
    "./learning/*": "./src/learning/*.ts",
    "./modules/auth": "./src/modules/auth/index.ts",
    "./modules/ai-feedback": "./src/modules/ai-feedback/index.ts",
    "./modules/content": "./src/modules/content/index.ts",
    "./modules/learner-api": "./src/modules/learner-api/index.ts",
    "./modules/learning": "./src/modules/learning/index.ts",
    "./result": "./src/result.ts",
    "./status": "./src/status.ts"
  },
  "scripts": {
    "lint": "oxlint .",
    "test": "bun --bun ../../node_modules/vitest/vitest.mjs run --config vitest.config.ts",
    "test:watch": "bun --bun ../../node_modules/vitest/vitest.mjs watch --config vitest.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@workspace/db": "workspace:*",
    "better-auth": "^1.6.0",
    "drizzle-orm": "^0.45.0",
    "openai": "^6.39.0",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.10",
    "@workspace/config": "workspace:*",
    "typescript": "5.9.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.0"
  }
}

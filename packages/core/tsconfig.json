{
  "extends": "@workspace/config/typescript/base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "paths": { "@/*": ["./src/*"], "@load/*": ["./load/*"] },
    "types": ["bun"]
  },
  "include": ["load/**/*.ts", "src/**/*.ts", "vitest.config.ts"],
  "exclude": ["node_modules", "dist"]
}

{
  "info": {
    "description": "글숨 Labs API입니다. 첫 문장 루프와 문체 정원 중심 워크플로우를 지원합니다.",
    "title": "Geulsoom Labs API",
    "version": "1.0.0"
  },
  "openapi": "3.0.0",
  "servers": [
    {
      "description": "API 서버",
      "url": "http://localhost:3010"
    }
  ],
  "components": {
    "schemas": {},
    "parameters": {}
  },
  "paths": {
    "/health": {
      "get": {
        "description": "DB 쿼리 가능 여부와 AI 서브시스템 상태를 함께 확인합니다.",
        "summary": "헬스 체크",
        "tags": ["시스템"],
        "responses": {
          "200": {
            "description": "성공",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ai": {
                      "type": "object",
                      "properties": {
                        "reason": {
                          "type": "string"
                        },
                        "status": {
                          "type": "string",
                          "enum": ["degraded"]
                        }
                      },
                      "required": ["reason", "status"]
                    },
                    "db": {
                      "type": "object",
                      "properties": {
                        "latencyMs": {
                          "type": "integer",
                          "nullable": true,
                          "minimum": 0
                        },
                        "status": {
                          "type": "string",
                          "enum": ["degraded", "ok"]
                        }
                      },
                      "required": ["latencyMs", "status"]
                    },
                    "sqliteVersion": {
                      "type": "string"
                    },
                    "status": {
                      "type": "string",
                      "enum": ["degraded", "ok"]
                    }
                  },
                  "required": ["ai", "db", "sqliteVersion", "status"]
                }
              }
            }
          },
          "default": {
            "description": "에러 응답",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "code": {
                          "type": "string"
                        },
                        "details": {
                          "nullable": true
                        },
                        "message": {
                          "type": "string"
                        },
                        "requestId": {
                          "type": "string"
                        }
                      },
                      "required": ["code", "message"]
                    }
                  },
                  "required": ["error"]
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/sign-up/email": {
      "post": {
        "description": "이메일과 비밀번호로 회원가입합니다. 가입 후 이메일 인증이 필요합니다.",
        "summary": "이메일 회원가입",
        "tags": ["인증"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email"
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "password": {
                    "type": "string",
                    "minLength": 8,
                    "maxLength": 128
                  }
                },
                "required": ["email", "name", "password"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "회원가입 성공",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "email": {
                      "type": "string"
                    },
                    "name": {
                      "type": "string"
                    }
                  },
                  "required": ["id", "email", "name"]
                }
              }
            }
          },
          "default": {
            "description": "에러 응답",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "code": {
                          "type": "string"
                        },
                        "details": {
                          "nullable": true
                        },
                        "message": {
                          "type": "string"
                        },
                        "requestId": {
                          "type": "string"
                        }
                      },
                      "required": ["code", "message"]
                    }
                  },
                  "required": ["error"]
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/sign-in/email": {
      "post": {
        "description": "이메일과 비밀번호로 로그인합니다.",
        "summary": "이메일 로그인",
        "tags": ["인증"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email"
                  },
                  "password": {
                    "type": "string"
                  }
                },
                "required": ["email", "password"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "로그인 성공",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "session": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string"
                        },
                        "token": {
                          "type": "string"
                        },
                        "userId": {
                          "type": "string"
                        }
                      },
                      "required": ["id", "token", "userId"]
                    },
                    "user": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string"
                        },
                        "email": {
                          "type": "string"
                        },
                        "name": {
                          "type": "string"
                        }
                      },
                      "required": ["id", "email", "name"]
                    }
                  },
                  "required": ["session", "user"]
                }
              }
            }
          },
          "default": {
            "description": "에러 응답",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "code": {
                          "type": "string"
                        },
                        "details": {
                          "nullable": true
                        },
                        "message": {
                          "type": "string"
                        },
                        "requestId": {
                          "type": "string"
                        }
                      },
                      "required": ["code", "message"]
                    }
                  },
                  "required": ["error"]
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/sign-out": {
      "post": {
        "description": "현재 세션을 종료하고 로그아웃합니다.",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "summary": "로그아웃",
        "tags": ["인증"],
        "responses": {
          "200": {
            "description": "로그아웃 성공",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    }
                  },
                  "required": ["success"]
                }
              }
            }
          },
          "default": {
            "description": "에러 응답",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "code": {
                          "type": "string"
                        },
                        "details": {
                          "nullable": true
                        },
                        "message": {
                          "type": "string"
                        },
                        "requestId": {
                          "type": "string"
                        }
                      },
                      "required": ["code", "message"]
                    }
                  },
                  "required": ["error"]
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/forget-password": {
      "post": {
        "description": "비밀번호 재설정 이메일을 전송합니다.",
        "summary": "비밀번호 재설정 요청",
        "tags": ["인증"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email"
                  },
                  "redirectTo": {
                    "type": "string",
                    "format": "uri"
                  }
                },
                "required": ["email"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "재설정 이메일 전송 완료",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "boolean"
                    }
                  },
                  "required": ["status"]
                }
              }
            }
          },
          "default": {
            "description": "에러 응답",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "code": {
                          "type": "string"
                        },
                        "details": {
                          "nullable": true
                        },
                        "message": {
                          "type": "string"
                        },
                        "requestId": {
                          "type": "string"
                        }
                      },
                      "required": ["code", "message"]
                    }
                  },
                  "required": ["error"]
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/reset-password": {
      "post": {
        "description": "이메일로 전송된 토큰을 사용하여 비밀번호를 재설정합니다.",
        "summary": "비밀번호 재설정",
        "tags": ["인증"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "newPassword": {
                    "type": "string",
                    "minLength": 8,
                    "maxLength": 128
                  },
                  "token": {
                    "type": "string"
                  }
                },
                "required": ["newPassword", "token"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "비밀번호 재설정 성공",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "boolean"
                    }
                  },
                  "required": ["status"]
                }
              }
            }
          },
          "default": {
            "description": "에러 응답",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "code": {
                          "type": "string"
                        },
                        "details": {
                          "nullable": true
                        },
                        "message": {
                          "type": "string"
                        },
                        "requestId": {
                          "type": "string"
                        }
                      },
                      "required": ["code", "message"]
                    }
                  },
                  "required": ["error"]
                }
              }
            }
          }
        }
      }
    },
    "/me": {
      "get": {
        "description": "현재 인증된 사용자의 세션 정보를 반환합니다.",
        "summary": "세션 조회",
        "tags": ["인증"],
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "성공",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "session": {
                      "type": "object",
                      "properties": {
                        "createdAt": {
                          "anyOf": [
                            {
                              "type": "string"
                            },
                            {
                              "type": "string",
                              "format": "date-time"
                            }
                          ]
                        },
                        "expiresAt": {
                          "anyOf": [
                            {
                              "type": "string"
                            },
                            {
                              "type": "string",
                              "format": "date-time"
                            }
                          ]
                        },
                        "id": {
                          "type": "string"
                        },
                        "ipAddress": {
                          "type": "string",
                          "nullable": true
                        },
                        "token": {
                          "type": "string"
                        },
                        "updatedAt": {
                          "anyOf": [
                            {
                              "type": "string"
                            },
                            {
                              "type": "string",
                              "format": "date-time"
                            }
                          ]
                        },
                        "userAgent": {
                          "type": "string",
                          "nullable": true
                        },
                        "userId": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "createdAt",
                        "expiresAt",
                        "id",
                        "token",
                        "updatedAt",
                        "userId"
                      ]
                    },
                    "user": {
                      "type": "object",
                      "properties": {
                        "email": {
                          "type": "string"
                        },
                        "emailVerified": {
                          "type": "boolean"
                        },
                        "id": {
                          "type": "string"
                        },
                        "image": {
                          "type": "string",
                          "nullable": true
                        },
                        "name": {
                          "type": "string"
                        }
                      },
                      "required": ["email", "emailVerified", "id", "name"]
                    }
                  },
                  "required": ["session", "user"]
                }
              }
            }
          },
          "default": {
            "description": "에러 응답",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "code": {
                          "type": "string"
                        },
                        "details": {
                          "nullable": true
                        },
                        "message": {
                          "type": "string"
                        },
                        "requestId": {
                          "type": "string"
                        }
                      },
                      "required": ["code", "message"]
                    }
                  },
                  "required": ["error"]
                }
              }
            }
          }
        }
      }
    },
    "/home": {
      "get": {
        "description": "첫 문장 루프 시작 행동과 문체 정원 요약을 조회합니다.",
        "summary": "홈 조회",
        "tags": ["홈"],
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "성공",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "startActions": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string",
                            "enum": ["photo", "garden", "manual"]
                          },
                          "title": {
                            "type": "string"
                          },
                          "description": {
                            "type": "string"
                          },
                          "href": {
                            "type": "string"
                          }
                        },
                        "required": ["id", "title", "description", "href"]
                      }
                    },
                    "recentWork": {
                      "type": "object",
                      "nullable": true,
                      "properties": {
                        "sceneId": {
                          "type": "string"
                        },
                        "title": {
                          "type": "string"
                        },
                        "updatedAt": {
                          "type": "string"
                        }
                      },
                      "required": ["sceneId", "title", "updatedAt"]
                    },
                    "garden": {
                      "type": "object",
                      "properties": {
                        "cardCount": {
                          "type": "integer"
                        },
                        "sentenceCount": {
                          "type": "integer"
                        }
                      },
                      "required": ["cardCount", "sentenceCount"]
                    }
                  },
                  "required": ["startActions", "recentWork", "garden"]
                }
              }
            }
          },
          "default": {
            "description": "에러 응답",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "code": {
                          "type": "string"
                        },
                        "details": {
                          "nullable": true
                        },
                        "message": {
                          "type": "string"
                        },
                        "requestId": {
                          "type": "string"
                        }
                      },
                      "required": ["code", "message"]
                    }
                  },
                  "required": ["error"]
                }
              }
            }
          }
        }
      }
    },
    "/users/profile": {
      "get": {
        "description": "현재 로그인한 사용자의 프로필과 기본 통계를 조회합니다.",
        "summary": "프로필 조회",
        "tags": ["사용자"],
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "성공",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "email": {
                      "type": "string",
                      "format": "email"
                    },
                    "emailVerified": {
                      "type": "boolean"
                    },
                    "gardenCardCount": {
                      "type": "integer"
                    },
                    "image": {
                      "type": "string",
                      "nullable": true
                    },
                    "name": {
                      "type": "string"
                    },
                    "sentenceCount": {
                      "type": "integer"
                    }
                  },
                  "required": [
                    "email",
                    "emailVerified",
                    "gardenCardCount",
                    "name",
                    "sentenceCount"
                  ]
                }
              }
            }
          },
          "default": {
            "description": "에러 응답",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "code": {
                          "type": "string"
                        },
                        "details": {
                          "nullable": true
                        },
                        "message": {
                          "type": "string"
                        },
                        "requestId": {
                          "type": "string"
                        }
                      },
                      "required": ["code", "message"]
                    }
                  },
                  "required": ["error"]
                }
              }
            }
          }
        }
      }
    }
  }
}

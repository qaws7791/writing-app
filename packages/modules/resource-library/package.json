{
  "name": "@workspace/resource-library",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#resource-library/*": "./src/*"
  },
  "exports": {
    "./http": "./src/interface/http/resource-library-http.ts",
    "./module": "./src/module.ts",
    "./ports": "./src/application/ports/resource-library-ports.ts",
    "./queries": "./src/application/resource-library-queries.ts",
    "./reconciliation": "./src/application/resource-reconciliation.ts",
    "./schema": "./src/infrastructure/persistence/schema.ts"
  },
  "scripts": {
    "lint": "oxlint .",
    "test": "bun --bun ../../../node_modules/vitest/vitest.mjs run --config vitest.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/zod-openapi": "catalog:",
    "@workspace/auth": "workspace:*",
    "@workspace/contracts": "workspace:*",
    "@workspace/db": "workspace:*",
    "@workspace/http-platform": "workspace:*",
    "@workspace/kernel": "workspace:*",
    "@workspace/resource-document": "workspace:*",
    "@workspace/types": "workspace:*",
    "drizzle-orm": "catalog:",
    "hono": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@workspace/typescript-config": "workspace:*",
    "typescript": "catalog:",
    "vite-tsconfig-paths": "catalog:",
    "vitest": "catalog:"
  }
}

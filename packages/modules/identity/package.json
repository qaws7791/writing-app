{
  "name": "@workspace/identity",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#identity/*": "./src/*"
  },
  "exports": {
    "./admin-actor": "./src/domain/admin-actor.ts",
    "./application": "./src/application/identity-service.ts",
    "./http": "./src/interface/http/identity-http.ts",
    "./learner-profile": "./src/domain/learner-profile.ts",
    "./module": "./src/module.ts",
    "./ports": "./src/application/identity-ports.ts",
    "./purge": "./src/application/deleted-learner-purge.ts",
    "./queries": "./src/application/identity-queries.ts",
    "./schema": "./src/infrastructure/persistence/schema.ts",

{
  "extends": "@workspace/typescript-config/base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "paths": {
      "#ai/*": ["../../infra/ai/src/*"],
      "#ai-feedback/*": ["../ai-feedback/src/*"],
      "#auth/*": ["../../infra/auth/src/*"],
      "#content/*": ["../content/src/*"],
      "#db/*": ["../../infra/db/src/*"],
      "#http-platform/*": ["../../infra/http-platform/src/*"],
      "#identity/*": ["../identity/src/*"],
      "#learning/*": ["../learning/src/*"],
      "#operations/*": ["./src/*"]
    },
    "types": ["bun"]
  },
  "include": ["src/**/*.ts", "vitest.config.ts"],
  "exclude": ["node_modules", "dist"]
}

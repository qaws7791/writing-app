{
  "name": "@workspace/content",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#content/*": "./src/*"
  },
  "exports": {
    "./application": "./src/application/content-application.ts",
    "./commands": "./src/application/content-commands.ts",
    "./http": "./src/interface/http/content-http.ts",
    "./migration": "./src/infrastructure/persistence/schema-migration.ts",
    "./module": "./src/module.ts",
    "./normalization": "./src/domain/content-normalization.ts",
    "./ports": "./src/application/ports/content-ports.ts",
    "./queries": "./src/application/content-queries.ts",
    "./schema": "./src/infrastructure/persistence/schema.ts",
    "./seed": "./src/infrastructure/persistence/seed.ts"
  },
  "scripts": {
    "lint": "oxlint .",
    "test": "bun --bun ../../../node_modules/vitest/vitest.mjs run --config vitest.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/zod-openapi": "catalog:",
    "@workspace/contracts": "workspace:*",
    "@workspace/db": "workspace:*",
    "@workspace/event-contracts": "workspace:*",
    "@workspace/http-platform": "workspace:*",
    "@workspace/kernel": "workspace:*",
    "@workspace/types": "workspace:*",
    "drizzle-orm": "catalog:",
    "hono": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@workspace/typescript-config": "workspace:*",
    "typescript": "catalog:",
    "vite-tsconfig-paths": "catalog:",
    "vitest": "catalog:"
  }
}

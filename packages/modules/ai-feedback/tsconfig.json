{
  "extends": "@workspace/typescript-config/base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "paths": {
      "#ai/*": ["../../infra/ai/src/*"],
      "#ai-feedback/*": ["./src/*"],
      "#auth/*": ["../../infra/auth/src/*"],
      "#db/*": ["../../infra/db/src/*"],
      "#http-platform/*": ["../../infra/http-platform/src/*"]
    },
    "types": ["bun"]
  },
  "include": ["src/**/*.ts", "vitest.config.ts"],
  "exclude": ["node_modules", "dist"]
}

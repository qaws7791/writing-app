{
  "name": "@workspace/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#db/*": "./src/*"
  },
  "exports": {
    "./bound-parameter-chunks": "./src/bound-parameter-chunks.ts",
    "./client": "./src/client.ts",
    "./database-backup": "./src/database-backup.ts",
    "./destructive-operation-guard": "./src/destructive-operation-guard.ts",
    "./fts5": "./src/fts5.ts",
    "./learner-data-purge": "./src/learner-data-purge.ts",
    "./migration-runner": "./src/migration-runner.ts",
    "./sqlite-database": "./src/sqlite-database.ts",
    "./test-support/application-migration": "./src/test-support/application-migration.ts",
    "./test-support/sqlite-types": "./src/test-support/sqlite-types.ts"
  },
  "scripts": {
    "lint": "oxlint .",
    "test": "cd ../../.. && bun --bun node_modules/vitest/vitest.mjs run --config vitest.workspace.ts --project @workspace/db",
    "typecheck": "tsc7 --noEmit"
  },
  "dependencies": {
    "drizzle-orm": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@workspace/typescript-config": "workspace:*",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}

{
  "name": "@workspace/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#db/*": "./src/*"
  },
  "exports": {
    "./client": "./src/client.ts",
    "./database-backup": "./src/database-backup.ts",
    "./destructive-operation-guard": "./src/destructive-operation-guard.ts",
    "./migration-runner": "./src/migration-runner.ts",
    "./sqlite-database": "./src/sqlite-database.ts",
    "./test-support/application-migration": "./src/test-support/application-migration.ts"
  },
  "scripts": {
    "lint": "oxlint .",
    "test": "bun --bun ../../../node_modules/vitest/vitest.mjs run --config vitest.config.ts",
    "test:watch": "bun --bun ../../../node_modules/vitest/vitest.mjs watch --config vitest.config.ts",
    "typecheck": "tsc7 --noEmit"
  },
  "dependencies": {
    "drizzle-orm": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@workspace/typescript-config": "workspace:*",
    "typescript": "catalog:",
    "vite-tsconfig-paths": "catalog:",
    "vitest": "catalog:"
  }
}

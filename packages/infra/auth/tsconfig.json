{
  "extends": "@workspace/typescript-config/base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "paths": {
      "#auth/*": ["./src/*"],
      "#db/*": ["../db/src/*"]
    },
    "types": ["bun", "@cloudflare/workers-types"]
  },
  "include": ["src/**/*.ts", "vitest.config.ts"],
  "exclude": ["node_modules", "dist"]
}

{
  "name": "@workspace/http-client",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#http-client/*": "./src/*"
  },
  "exports": {
    "./admin": "./.generated/admin/index.ts",
    "./admin/msw": "./.generated/admin/mocks/handlers.ts",
    "./api-result": "./src/api-result.ts",
    "./generated-fetch": "./src/generated-fetch.ts",
    "./learner": "./.generated/learner/index.ts",
    "./learner/msw": "./.generated/learner/mocks/handlers.ts",
    "./msw-fixtures": "./src/msw-fixtures.ts"
  },
  "scripts": {
    "generate": "orval --config orval.config.ts && bun src/scripts/generate-msw-handler-exports.ts",
    "lint": "oxlint .",
    "typecheck": "tsc7 --noEmit"
  },
  "devDependencies": {
    "@faker-js/faker": "catalog:",
    "@types/bun": "catalog:",
    "@workspace/typescript-config": "workspace:*",
    "msw": "catalog:",
    "orval": "catalog:",
    "typescript": "catalog:"
  },
  "dependencies": {
    "@workspace/contracts": "workspace:*"
  }
}

{
  "extends": "@workspace/typescript-config/base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "paths": { "#http-client/*": ["./src/*"] },
    "types": ["bun"]
  },
  "include": [
    ".generated/**/*.ts",
    "orval.config.ts",
    "src/**/*.ts",
    "vitest.config.ts"
  ],
  "exclude": ["node_modules", "dist"]
}

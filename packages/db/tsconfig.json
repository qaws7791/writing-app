{
  "extends": "@workspace/config/typescript/base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "paths": {
      "@/admin": ["../core/src/admin/index.ts"],
      "@/admin/*": ["../core/src/admin/*"],
      "@/ai-feedback": ["../core/src/ai-feedback/index.ts"],
      "@/ai-feedback/*": ["../core/src/ai-feedback/*"],
      "@/content": ["../core/src/content/index.ts"],
      "@/content/*": ["../core/src/content/*"],
      "@/learning": ["../core/src/learning/index.ts"],
      "@/learning/*": ["../core/src/learning/*"],
      "@/*": ["./src/*"]
    },
    "types": ["bun"]
  },
  "include": ["src/**/*.ts", "vitest.config.ts"],
  "exclude": ["node_modules", "dist"]
}

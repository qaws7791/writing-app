{
  "name": "@workspace/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client.ts",
    "./database-backup": "./src/database-backup.ts",
    "./content/*": "./src/content/*.ts",
    "./destructive-operation-guard": "./src/destructive-operation-guard.ts",
    "./migrations/*": "./src/migrations/*.ts",
    "./persisted-values": "./src/persisted-values.ts",
    "./schema": "./src/schema/index.ts",
    "./schema/*": "./src/schema/*.ts",
    "./seed": "./src/seeds/index.ts",
    "./seeds/*": "./src/seeds/*.ts"
  },
  "scripts": {
    "db:migrate": "bun src/migrations/migrate.ts",
    "db:backup": "bun src/scripts/backup-database.ts",
    "db:reset": "bun src/scripts/reset-database.ts",
    "db:seed": "bun src/seeds/seed.ts",
    "lint": "oxlint .",
    "test": "bun --bun ../../node_modules/vitest/vitest.mjs run --config vitest.config.ts",
    "test:watch": "bun --bun ../../node_modules/vitest/vitest.mjs watch --config vitest.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.0",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.10",
    "@workspace/config": "workspace:*",
    "drizzle-kit": "^0.31.0",
    "typescript": "5.9.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "catalog:"
  }
}

{
  "name": "@workspace/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#ui/*": "./src/*"
  },
  "sideEffects": [
    "*.css",
    "./src/styles/pretendard-font.ts"
  ],
  "exports": {
    "./blocks/*": "./src/blocks/*.tsx",
    "./components/*": "./src/components/*.tsx",
    "./hooks/*": "./src/hooks/*.ts",
    "./lib/*": "./src/lib/*.ts",
    "./pretendard-font": "./src/styles/pretendard-font.ts",
    "./styles": "./src/styles/globals.css"
  },
  "scripts": {
    "lint": "oxlint .",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc7 --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "catalog:",
    "@dnd-kit/dom": "catalog:",
    "@dnd-kit/react": "catalog:",
    "@hugeicons/core-free-icons": "catalog:",
    "@hugeicons/react": "catalog:",
    "@shadcn/react": "catalog:",
    "@tanstack/react-table": "catalog:",
    "@workspace/kernel": "workspace:*",
    "class-variance-authority": "catalog:",
    "clsx": "catalog:",
    "cmdk": "catalog:",
    "input-otp": "catalog:",
    "pretendard": "catalog:",
    "react-day-picker": "catalog:",
    "react-markdown": "^10.1.0",
    "recharts": "catalog:",
    "tailwind-merge": "catalog:"
  },
  "peerDependencies": {
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/bun": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@workspace/typescript-config": "workspace:*",
    "@workspace/vitest-config": "workspace:*",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}

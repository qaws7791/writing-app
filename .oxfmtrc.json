{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "endOfLine": "lf",
  "semi": false,
  "singleQuote": false,
  "tabWidth": 2,
  "trailingComma": "es5",
  "printWidth": 80,
  "sortPackageJson": false,
  "ignorePatterns": [
    "node_modules",
    ".pnp",
    ".pnp.js",
    ".env",
    ".env.docker",
    ".env.local",
    ".env.development.local",
    ".env.test.local",
    ".env.production.local",
    "apps/api/.env.development",
    "apps/api/.generated/",
    "coverage",
    ".turbo",
    ".worktrees/",
    ".vscode/",
    ".vercel",
    ".next/",
    "apps/*/next-env.d.ts",
    "out/",
    "build",
    "dist",
    "*.tsbuildinfo",
    "npm-debug.log*",
    "yarn-debug.log*",
    "yarn-error.log*",
    ".DS_Store",
    "*.pem",
    "docs/.obsidian/",
    ".agent",
    ".agents",
    "Kwep/",
    "data",
    "credentials"
  ]
}

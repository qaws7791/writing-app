{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "endOfLine": "lf",
  "semi": false,
  "singleQuote": false,
  "tabWidth": 2,
  "trailingComma": "es5",
  "printWidth": 80,
  "sortPackageJson": false,
  "ignorePatterns": [
    "node_modules",
    ".pnp",
    ".pnp.js",
    ".env",
    ".env.docker",
    ".env.local",
    ".env.development.local",
    ".env.test.local",
    ".env.production.local",
    "apps/api/.env.development",
    "apps/api/.generated/",
    "packages/infra/http-client/.generated/",
    "coverage",
    "test-results",
    "playwright-report",
    ".turbo",
    ".worktrees/",
    ".vscode/",
    ".vercel",
    ".next/",
    "apps/ui/.astro/",
    "apps/ui/public/",
    "apps/ui/src/generated/",
    "apps/*/next-env.d.ts",
    "out/",
    "build",
    "dist",
    "*.tsbuildinfo",
    "npm-debug.log*",
    "yarn-debug.log*",
    "yarn-error.log*",
    ".DS_Store",
    "*.pem",
    "docs/.obsidian/",
    ".agent",
    ".agents",
    "Kwep/",
    "data",
    "credentials"
  ],
  "overrides": [
    {
      "files": ["apps/ui/**/*"],
      "options": {
        "printWidth": 100,
        "semi": true,
        "trailingComma": "all"
      }
    }
  ]
}

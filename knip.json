{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreFiles": ["packages/**/src/**/*.typecheck.{ts,tsx}"],
  "workspaces": {
    ".": {
      "entry": [
        "e2e/**/*.spec.ts",
        "lighthouse-ci.config.cjs!",
        "playwright*.config.ts!",
        "scripts/k6-staging-smoke.js!",
        "scripts/**/*.test.ts",
        "scripts/start-e2e-frontend.ts"
      ],
      "project": [
        "*.{js,cjs,mjs,ts,cts,mts}",
        "e2e/**/*.{ts,tsx}",
        "scripts/**/*.{js,cjs,mjs,ts,cts,mts}"
      ],
      "ignoreDependencies": ["@lhci/cli", "@testing-library/dom", "^k6(?:/|$)"],
      "playwright": false
    },
    "apps/*": {
      "entry": [
        "src/app/**/{default,error,global-error,layout,loading,not-found,page,route,template}.{ts,tsx}!",
        "src/**/*.{test,spec}.{ts,tsx}"
      ],
      "project": ["src/**/*.{css,ts,tsx}"],
      "ignoreDependencies": ["cloudflare"]
    },
    "apps/api": {
      "entry": [
        "src/scripts/*.ts!",
        "src/test-support/setup-e2e-content-database.ts!",
        "src/test-support/setup-e2e-database.ts!",
        "src/test-support/start-e2e-api.ts!",
        "src/**/*.{test,spec}.ts",
        "src/db/schema.ts",
        "src/test-support/seed-e2e-database.ts!"
      ],
      "project": ["src/**/*.ts"]
    },
    "apps/ui": {
      "entry": [
        "scripts/*.ts!",
        "src/components/**/*.tsx!",
        "src/pages/**/*.astro!",
        "tests/**/*.spec.ts"
      ],
      "project": [
        "scripts/**/*.ts",
        "src/**/*.{astro,css,ts,tsx}",
        "tests/**/*.ts"
      ],
      "ignoreIssues": {
        "src/lib/block-docs.ts": ["exports", "types"],
        "src/lib/component-docs.ts": ["exports"],
        "src/lib/component-guides/index.ts": ["types"],
        "src/lib/component-guides/types.ts": ["types"]
      }
    },
    "packages/shared/contracts": {
      "project": ["src/**/*.{ts,tsx}"],
      "ignoreIssues": {
        "src/content/authoring/lesson-templates.ts": ["exports"]
      }
    },
    "packages/{config,infra,shared}/*": {
      "project": ["src/**/*.{ts,tsx}"]
    },
    "packages/modules/*": {
      "includeEntryExports": true,
      "project": ["src/**/*.{ts,tsx}"],
      "ignoreIssues": {
        "src/infrastructure/persistence/schema.ts": ["exports"],
        "src/infrastructure/persistence/reporting-view.ts": ["exports"]
      }
    },
    "packages/config/typescript-config": {
      "entry": ["base.json!", "nextjs.json!", "react-library.json!"],
      "project": [],
      "ignoreUnresolved": ["^next$"]
    },
    "packages/infra/http-client": {
      "includeEntryExports": true,
      "project": [
        ".generated/**/*.ts",
        "*.{js,cjs,mjs,ts,cts,mts}",
        "src/**/*.ts"
      ],
      "ignoreIssues": {
        ".generated/**": [
          "duplicates",
          "enumMembers",
          "exports",
          "files",
          "namespaceMembers",
          "nsExports",
          "nsTypes",
          "types"
        ]
      }
    },
    "packages/shared/ui": {
      "project": ["src/**/*.{ts,tsx}"],
      "ignoreIssues": {
        "src/blocks/**": ["duplicates"]
      }
    }
  }
}

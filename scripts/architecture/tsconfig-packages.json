{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "baseUrl": "../..",
    "paths": {
      "#auth/*": ["packages/infra/auth/src/*"],
      "#env/*": ["packages/config/env/src/*"],
      "#contracts/*": ["packages/shared/contracts/src/*"],
      "#resource-document/*": ["packages/shared/resource-document/src/*"],
      "#ui/*": ["packages/shared/ui/src/*"]
    }
  },
  "include": ["../../packages/**/*.ts", "../../packages/**/*.tsx"],
  "exclude": [
    "../../packages/**/.turbo",
    "../../packages/**/dist",
    "../../packages/**/node_modules"
  ]
}

{
  "compilerOptions": {
    "baseUrl": ".",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "paths": {
      "#alpha/*": ["packages/modules/alpha/src/*"],
      "#beta/*": ["packages/modules/beta/src/*"],
      "@fixture/alpha/schema": [
        "packages/modules/alpha/src/infrastructure/persistence/schema.ts"
      ],
      "@fixture/contracts/content/course": [
        "packages/shared/contracts/src/content/course.ts"
      ]
    }
  },
  "include": ["apps/**/*.ts", "packages/**/*.ts"]
}

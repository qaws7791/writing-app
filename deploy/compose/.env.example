# Compose 보간에는 image와 host 경로만 둔다. API·Litestream secret은
# CONFIG_DIRECTORY 아래 권한 제한 runtime env 파일로 별도 주입한다.
WEB_IMAGE=ghcr.io/example/writing-app-web:replace-with-image-reference
API_IMAGE=ghcr.io/example/writing-app-api:replace-with-image-reference
ADMIN_IMAGE=ghcr.io/example/writing-app-admin:replace-with-image-reference
CADDY_IMAGE=caddy:2.11.4-alpine
LITESTREAM_IMAGE=litestream/litestream:0.5.11
CONFIG_DIRECTORY=/etc/writing-app/config
DATA_DIRECTORY=/var/lib/writing-app
BACKUP_DIRECTORY=/var/backups/writing-app

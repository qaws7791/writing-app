{
	admin 127.0.0.1:2019
}

(learner-routes) {
	@learner-csp path /api/csp-report
	handle @learner-csp {
		reverse_proxy web:3000
	}

	@learner-admin-api path /api/admin /api/admin/*
	handle @learner-admin-api {
		respond "not found" 404
	}

	@learner-api path /api/*
	handle @learner-api {
		reverse_proxy api:4000 {
			header_up X-Writing-App-Client-IP {http.request.remote.host}
		}
	}

	handle {
		reverse_proxy web:3000
	}
}

(admin-routes) {
	@admin-api path /api/admin /api/admin/*
	handle @admin-api {
		reverse_proxy api:4000 {
			header_up X-Writing-App-Client-IP {http.request.remote.host}
		}
	}

	handle {
		reverse_proxy admin:3001
	}
}

(admin-mcp-routes) {
	@admin-mcp path /mcp/admin
	handle @admin-mcp {
		reverse_proxy api:4000 {
			header_up X-Writing-App-Client-IP {http.request.remote.host}
		}
	}

	handle {
		respond "not found" 404
	}
}

{$WEB_HOST} {
	import learner-routes
}

{$ADMIN_HOST} {
	import admin-routes
}

import /etc/caddy/sites/*.caddy

http://127.0.0.1:8080 {
	handle /healthz {
		respond "ok" 200
	}
}

http://{$WEB_HOST}:8080 {
	import learner-routes
}

http://{$ADMIN_HOST}:8080 {
	import admin-routes
}

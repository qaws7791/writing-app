{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "ADMIN_EMAIL",
    "ADMIN_JWT_SECRET",
    "ADMIN_NAME",
    "ADMIN_PASSWORD",
    "CI",
    "DATABASE_URL",
    "NODE_ENV",
    "RESEND_API_KEY",
    "RESEND_FROM_ADDRESS",
    "STORAGE_ENDPOINT",
    "STORAGE_ACCESS_KEY",
    "STORAGE_SECRET_KEY",
    "STORAGE_PUBLIC_BUCKET",
    "STORAGE_REGION",
    "STORAGE_PUBLIC_URL"
  ],
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "dependsOn": ["^test"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}

{
  "$schema": "https://turbo.build/schema.json",
  "globalPassThroughEnv": ["CI", "E2E_RUN_ROOT", "NEXT_RUNTIME", "E2E_RUNTIME"],
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["generate", "^generate", "^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*", ".dev.vars*"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "generate": {
      "outputs": [".generated/**"]
    },
    "@workspace/http-client#generate": {
      "dependsOn": ["@workspace/api#generate"],
      "outputs": [".generated/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "typecheck": {
      "dependsOn": ["generate", "^generate", "^typecheck"]
    },
    "test": {
      "dependsOn": ["generate", "^generate"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/apps/api/migrations/**"]
    },
    "dev": {
      "cache": false,
      "dependsOn": ["generate", "^generate"],
      "persistent": true
    }
  },
  "globalEnv": ["CLOUDFLARE_ENV", "CLOUDFLARE_CONFIG"]
}

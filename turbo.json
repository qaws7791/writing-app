{
  "$schema": "https://turbo.build/schema.json",
  "globalPassThroughEnv": [
    "CI",
    "NEXT_RUNTIME",
    "WRITING_APP_DISPOSABLE_UBUNTU"
  ],
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["generate", "^generate", "^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "generate": {
      "outputs": [".generated/**"]
    },
    "@workspace/http-client#generate": {
      "dependsOn": ["@workspace/api#generate"],
      "outputs": [".generated/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "typecheck": {
      "dependsOn": ["generate", "^generate", "^typecheck"]
    },
    "test": {
      "dependsOn": ["generate", "^generate"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/apps/api/drizzle/**"]
    },
    "dev": {
      "cache": false,
      "dependsOn": ["generate", "^generate"],
      "persistent": true
    }
  }
}

{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "login-workspace",
  "title": "Login Workspace",
  "description": "워크스페이스 URL과 SSO를 우선하는 B2B 조직 로그인 흐름입니다.",
  "registryDependencies": [
    "https://YOUR_GITHUB_ID.github.io/ui/r/base.json",
    "https://YOUR_GITHUB_ID.github.io/ui/r/button.json",
    "https://YOUR_GITHUB_ID.github.io/ui/r/field.json",
    "https://YOUR_GITHUB_ID.github.io/ui/r/input.json"
  ],
  "files": [
    {
      "path": "registry/luma/blocks/login-workspace.tsx",
      "content": "\"use client\";\n\nimport * as React from \"react\";\n\nimport { cn } from \"@/registry/luma/lib/utils\";\nimport { Button } from \"@/registry/luma/ui/button\";\nimport {\n  Field,\n  FieldDescription,\n  FieldGroup,\n  FieldLabel,\n  FieldSeparator,\n} from \"@/registry/luma/ui/field\";\nimport { Input } from \"@/registry/luma/ui/input\";\n\n/**\n * Workspace / SSO login for B2B products.\n * Use when organization context comes before personal credentials.\n */\nexport function LoginWorkspace({ className, ...props }: React.ComponentProps<\"div\">) {\n  const [mode, setMode] = React.useState<\"workspace\" | \"sso\">(\"workspace\");\n\n  return (\n    <div\n      data-slot=\"login-workspace\"\n      className={cn(\"@container min-h-svh w-full\", className)}\n      {...props}\n    >\n      <div className=\"grid min-h-svh w-full @[56rem]:grid-cols-[1.05fr_0.95fr]\">\n        <section className=\"relative hidden overflow-hidden border-r bg-surface @[56rem]:block\">\n          <div\n            className=\"absolute inset-0 bg-[radial-gradient(90%_70%_at_0%_0%,oklch(0.9_0.03_145_/_0.55)_0%,transparent_55%),radial-gradient(70%_60%_at_100%_100%,oklch(0.88_0.02_75_/_0.4)_0%,transparent_50%)]\"\n            aria-hidden=\"true\"\n          />\n          <div className=\"relative flex h-full flex-col justify-between p-12\">\n            <p className=\"font-heading text-3xl font-semibold tracking-[-0.05em]\">Luma</p>\n            <div className=\"max-w-md\">\n              <p className=\"font-heading text-3xl leading-snug font-semibold tracking-[-0.04em] text-balance\">\n                팀 워크스페이스로 바로 들어가세요.\n              </p>\n              <p className=\"mt-4 text-sm leading-7 text-muted-foreground\">\n                조직 도메인과 SSO를 먼저 확인한 뒤, 구성원 계정으로 이어집니다. 개인 비밀번호보다\n                회사 정책을 앞세웁니다.\n              </p>\n              <dl className=\"mt-10 grid gap-5 text-sm\">\n                <div>\n                  <dt className=\"font-medium tracking-[-0.01em]\">단일 로그인</dt>\n                  <dd className=\"mt-1 text-muted-foreground\">Okta, Google Workspace, Azure AD</dd>\n                </div>\n                <div>\n                  <dt className=\"font-medium tracking-[-0.01em]\">역할 기반 접근</dt>\n                  <dd className=\"mt-1 text-muted-foreground\">편집자, 검토자, 관리자 권한 유지</dd>\n                </div>\n              </dl>\n            </div>\n            <p className=\"text-xs tracking-[0.04em] text-muted-foreground uppercase\">\n              Enterprise access\n            </p>\n          </div>\n        </section>\n\n        <main className=\"flex flex-col justify-center bg-background px-6 py-14 sm:px-10 @[56rem]:px-16\">\n          <div className=\"mx-auto w-full max-w-[23rem]\">\n            <div className=\"mb-8 @[56rem]:hidden\">\n              <p className=\"font-heading text-3xl font-semibold tracking-[-0.05em]\">Luma</p>\n            </div>\n\n            <header className=\"mb-8\">\n              <h1 className=\"font-heading text-2xl font-semibold tracking-[-0.03em]\">\n                워크스페이스 로그인\n              </h1>\n              <p className=\"mt-2 text-sm leading-6 text-muted-foreground\">\n                조직 URL 또는 회사 이메일로 시작하세요.\n              </p>\n            </header>\n\n            <div\n              role=\"tablist\"\n              aria-label=\"로그인 방식\"\n              className=\"mb-7 grid grid-cols-2 gap-1 rounded-2xl border border-border/70 bg-muted/40 p-1\"\n            >\n              <button\n                type=\"button\"\n                role=\"tab\"\n                aria-selected={mode === \"workspace\"}\n                className={cn(\n                  \"rounded-xl px-3 py-2 text-sm font-medium transition-colors\",\n                  mode === \"workspace\"\n                    ? \"bg-card text-foreground shadow-2xs\"\n                    : \"text-muted-foreground hover:text-foreground\",\n                )}\n                onClick={() => setMode(\"workspace\")}\n              >\n                워크스페이스\n              </button>\n              <button\n                type=\"button\"\n                role=\"tab\"\n                aria-selected={mode === \"sso\"}\n                className={cn(\n                  \"rounded-xl px-3 py-2 text-sm font-medium transition-colors\",\n                  mode === \"sso\"\n                    ? \"bg-card text-foreground shadow-2xs\"\n                    : \"text-muted-foreground hover:text-foreground\",\n                )}\n                onClick={() => setMode(\"sso\")}\n              >\n                SSO\n              </button>\n            </div>\n\n            {mode === \"workspace\" ? (\n              <form className=\"flex flex-col gap-6\" onSubmit={(event) => event.preventDefault()}>\n                <FieldGroup>\n                  <Field>\n                    <FieldLabel htmlFor=\"login-workspace-slug\">워크스페이스 URL</FieldLabel>\n                    <div className=\"flex items-center gap-2\">\n                      <Input\n                        id=\"login-workspace-slug\"\n                        name=\"workspace\"\n                        autoComplete=\"organization\"\n                        placeholder=\"acme\"\n                        className=\"flex-1\"\n                        required\n                      />\n                      <span className=\"shrink-0 text-sm text-muted-foreground\">.luma.app</span>\n                    </div>\n                    <FieldDescription>관리자에게 받은 팀 주소를 입력하세요.</FieldDescription>\n                  </Field>\n                </FieldGroup>\n                <Button type=\"submit\" size=\"lg\" className=\"w-full\">\n                  워크스페이스 열기\n                </Button>\n              </form>\n            ) : (\n              <form className=\"flex flex-col gap-6\" onSubmit={(event) => event.preventDefault()}>\n                <FieldGroup>\n                  <Field>\n                    <FieldLabel htmlFor=\"login-workspace-sso-email\">회사 이메일</FieldLabel>\n                    <Input\n                      id=\"login-workspace-sso-email\"\n                      type=\"email\"\n                      autoComplete=\"email\"\n                      placeholder=\"you@company.com\"\n                      required\n                    />\n                    <FieldDescription>등록된 도메인이면 회사 IdP로 이동합니다.</FieldDescription>\n                  </Field>\n                </FieldGroup>\n                <Button type=\"submit\" size=\"lg\" className=\"w-full\">\n                  SSO로 계속\n                </Button>\n              </form>\n            )}\n\n            <FieldSeparator className=\"my-7\">또는</FieldSeparator>\n\n            <Button type=\"button\" variant=\"outline\" size=\"lg\" className=\"w-full\">\n              개인 계정으로 로그인\n            </Button>\n\n            <FieldDescription className=\"mt-6 text-center\">\n              새 조직을 만드나요?{\" \"}\n              <a href=\"#create-workspace\" className=\"text-foreground\">\n                워크스페이스 생성\n              </a>\n            </FieldDescription>\n          </div>\n        </main>\n      </div>\n    </div>\n  );\n}\n\nexport default LoginWorkspace;\n",
      "type": "registry:block"
    }
  ],
  "categories": [
    "authentication",
    "login"
  ],
  "type": "registry:block"
}
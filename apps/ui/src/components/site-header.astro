---
import ColorThemePicker from "@/src/components/color-theme-picker"
import DocsSearch from "@/src/components/docs-search"
import { docsNavigation, docsSearchRecords, withBase } from "@/src/lib/docs-catalog"

type Props = {
  active?: "home" | "docs" | "blocks"
  pathname?: string
}

const { active = "home", pathname } = Astro.props
const baseUrl = import.meta.env.BASE_URL
const docsHref = withBase(baseUrl, "/docs/getting-started")
const blocksHref = withBase(baseUrl, "/docs/blocks")

const navClass = (item: "home" | "docs" | "blocks") =>
  item === active
    ? "rounded-xl bg-muted px-3 py-2 font-medium"
    : "rounded-xl px-3 py-2 text-muted-foreground hover:bg-muted hover:text-foreground"
---

<header class="sticky top-0 z-50 border-b bg-background/90 backdrop-blur-xl">
  <div class="mx-auto flex h-15 max-w-[1500px] items-center gap-4 px-4 lg:px-6">
    <a href={baseUrl} class="flex shrink-0 items-center gap-2.5 font-heading text-sm font-semibold">
      <span class="grid size-8 place-items-center rounded-2xl bg-foreground text-xs text-background">L</span>
      <span class="hidden sm:inline">Luma UI</span>
    </a>
    <nav class="hidden items-center gap-1 text-sm lg:flex" aria-label="전역 메뉴">
      <a class={navClass("home")} href={baseUrl}>홈</a>
      <a class={navClass("docs")} href={docsHref}>문서</a>
      <a class={navClass("blocks")} href={blocksHref}>블록</a>
      <a class="rounded-xl px-3 py-2 text-muted-foreground hover:bg-muted hover:text-foreground" href={`${baseUrl}r/registry.json`}>레지스트리</a>
    </nav>
    <div class="ml-auto flex min-w-0 items-center gap-2">
      <div class="hidden sm:block">
        <DocsSearch records={docsSearchRecords} baseUrl={baseUrl} client:load />
      </div>
      <a href="https://github.com/qaws7791/ui" target="_blank" rel="noreferrer" class="hidden rounded-xl px-3 py-2 text-sm text-muted-foreground hover:bg-muted hover:text-foreground md:block">GitHub</a>
      <ColorThemePicker client:load />
      <details class="relative lg:hidden">
        <summary class="cursor-pointer list-none rounded-xl border px-3 py-2 text-sm">메뉴</summary>
        <div class="absolute right-0 mt-2 w-80 rounded-3xl border bg-popover p-3 shadow-xl">
          <DocsSearch records={docsSearchRecords} baseUrl={baseUrl} client:load />
          <nav class="mt-3 max-h-[65vh] overflow-y-auto" aria-label="모바일 문서 메뉴">
            {docsNavigation.map((section) => (
              <section class="mb-4">
                <h2 class="px-3 py-1 text-xs font-medium text-muted-foreground">{section.title}</h2>
                {section.items.map((item) => (
                  <a href={withBase(baseUrl, item.href)} class:list={["block rounded-xl px-3 py-2 text-sm", pathname === item.href ? "bg-muted font-medium" : "text-muted-foreground"]}>{item.title}</a>
                ))}
              </section>
            ))}
          </nav>
        </div>
      </details>
    </div>
  </div>
</header>

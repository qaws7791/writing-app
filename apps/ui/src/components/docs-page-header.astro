---
type Props = {
  eyebrow: string
  title: string
  description: string
}

const { eyebrow, title, description } = Astro.props
---

<header class="mb-12 max-w-3xl">
  <p class="text-sm font-medium tracking-[0.04em] text-muted-foreground uppercase">{eyebrow}</p>
  <h1 class="mt-3 font-heading text-4xl font-semibold tracking-[-0.04em] text-balance sm:text-5xl">{title}</h1>
  <p class="mt-4 text-base leading-7 text-pretty text-muted-foreground sm:text-lg sm:leading-8">{description}</p>
</header>

---
import DocsPageHeader from "@/src/components/docs-page-header.astro"
import DocsLayout from "@/src/layouts/docs-layout.astro"
import { designSystemInventory } from "@/src/lib/design-system-inventory"
import { withBase } from "@/src/lib/docs-catalog"

const baseUrl = import.meta.env.BASE_URL
const stories = designSystemInventory.modules.flatMap((module) => module.stories.map((story) => ({ ...story, module: module.title, ci: module.hasCiTest })))
---

<DocsLayout title="Migration Coverage" description="154개 실행 예제와 2개 문서의 Astro 목적지입니다." pathname="/docs/quality/migration-coverage" toc={[{ id: "summary", label: "요약" }, { id: "stories", label: "실행 예제" }, { id: "documents", label: "문서" }]}>
  <article>
    <DocsPageHeader eyebrow="Quality" title="Migration Coverage" description="기존 디자인 시스템 카탈로그의 39개 module, 154개 실행 예제와 2개 서술 문서를 공개 Astro 경로에 연결했습니다." />
    <section id="summary" class="scroll-mt-24 grid gap-3 sm:grid-cols-5">
      {Object.entries(designSystemInventory.counts).map(([label, value]) => <div class="rounded-3xl border p-4"><strong class="font-heading text-2xl">{value}</strong><span class="mt-1 block text-xs text-muted-foreground">{label}</span></div>)}
    </section>
    <section id="stories" class="scroll-mt-24 pt-16">
      <h2 class="font-heading text-2xl font-semibold">실행 예제 154개</h2>
      <div class="mt-6 overflow-hidden rounded-3xl border"><div class="max-h-[60rem] overflow-auto"><table class="w-full min-w-180 text-left text-xs"><thead class="sticky top-0 bg-muted"><tr><th class="px-4 py-3">Module</th><th class="px-4 py-3">Export</th><th class="px-4 py-3">계약</th><th class="px-4 py-3">목적지</th></tr></thead><tbody class="divide-y">{stories.map((story) => <tr><td class="px-4 py-3">{story.module}</td><td class="px-4 py-3 font-mono">{story.exportName}</td><td class="px-4 py-3">{[story.ci && "browser", story.hasPlay && "interaction"].filter(Boolean).join(", ") || "render"}</td><td class="px-4 py-3"><a class="font-medium underline underline-offset-4" href={withBase(baseUrl, story.destination)}>{story.destination}</a></td></tr>)}</tbody></table></div></div>
    </section>
    <section id="documents" class="scroll-mt-24 pt-16">
      <h2 class="font-heading text-2xl font-semibold">서술 문서 2개</h2>
      <div class="mt-5 grid gap-3">{designSystemInventory.mdx.map((document) => <a class="rounded-3xl border p-5 hover:bg-muted" href={withBase(baseUrl, document.destination)}><strong>{document.id}</strong><span class="mt-1 block text-sm text-muted-foreground">{document.destination}</span></a>)}</div>
    </section>
  </article>
</DocsLayout>

---
import CodeBlock from "@/src/components/code-block"
import ExampleShowcase from "@/src/components/example-showcase.astro"
import MigratedComponentStories from "@/src/components/migrated-component-stories.astro"
import ResponsivePreview from "@/src/components/responsive-preview"
import DocsLayout from "@/src/layouts/docs-layout.astro"
import { getComponentGuide } from "@/src/lib/component-guides"
import {
  componentDocs,
  getApiReference,
  getInstallCommand,
  getOfficialDocs,
  getPropDocs,
  type ComponentDoc,
} from "@/src/lib/component-docs"
import {
  getComponentExports,
  getComponentSource,
  getUsageCode,
} from "@/src/lib/component-source"
import { getMigratedStories } from "@/src/lib/design-system-inventory"

export function getStaticPaths() {
  return componentDocs.map((doc) => ({ params: { slug: doc.slug }, props: { doc } }))
}

type Props = { doc: ComponentDoc }

const { doc } = Astro.props
const currentIndex = componentDocs.findIndex((component) => component.slug === doc.slug)
const previous = currentIndex > 0 ? componentDocs.at(currentIndex - 1) : undefined
const next = componentDocs.at(currentIndex + 1)
const exports = getComponentExports(doc.slug)
const source = getComponentSource(doc.slug)
const guide = getComponentGuide(doc.slug, doc.title)
const usageCode = guide.examples.at(0)?.code ?? getUsageCode(doc.slug, exports)
const installCommand = getInstallCommand(doc.slug)
const props = guide.props ?? getPropDocs(doc.slug)
const baseUrl = import.meta.env.BASE_URL
const officialDocs = getOfficialDocs(doc.slug)
const apiReference = getApiReference(doc.slug)
const isLearning = doc.category === "Learning"
const storyModuleTitle = doc.slug === "spinner" ? "Components/UI/Status" : `Components/UI/${doc.title.replaceAll(" ", "")}`
const migratedStoryModules = [storyModuleTitle]
const migratedStories = migratedStoryModules.flatMap((title) => getMigratedStories(title))
const toc = [
  { id: "preview", label: "미리보기" },
  { id: "preview-lab", label: "반응형 미리보기" },
  { id: "usage", label: "가져오기" },
  ...guide.examples.map((example) => ({ id: example.id, label: example.title })),
  ...(migratedStories.length > 0 ? [{ id: "migrated-states", label: "이전된 실행 상태" }] : []),
  { id: "usage-guidelines", label: "사용 지침" },
  { id: "accessibility", label: "접근성" },
  { id: "props", label: "Props" },
  { id: "api-reference", label: "API Reference" },
]
---

<DocsLayout
  title={doc.title}
  description={doc.description}
  pathname={`/docs/components/${doc.slug}`}
  toc={toc}
>
  <article>
    <div class="mb-10 flex items-start justify-between gap-8">
      <div>
        <div class="mb-4 text-xs text-muted-foreground">{doc.category}</div>
        <h1 class="font-heading text-4xl font-semibold tracking-[-0.035em] sm:text-5xl">{doc.title}</h1>
        <p class="mt-4 max-w-2xl text-base leading-7 text-muted-foreground sm:text-lg">{doc.description}</p>
      </div>
      <div class="hidden gap-2 sm:flex">
        {previous && <a aria-label={`이전: ${previous.title}`} href={`${baseUrl}docs/components/${previous.slug}`} class="grid size-9 place-items-center rounded-xl border text-sm hover:bg-muted">←</a>}
        {next && <a aria-label={`다음: ${next.title}`} href={`${baseUrl}docs/components/${next.slug}`} class="grid size-9 place-items-center rounded-xl border text-sm hover:bg-muted">→</a>}
      </div>
    </div>

    <div class="mb-8 flex items-center gap-6 border-b text-sm">
      <span class="border-b-2 border-foreground pb-3 font-medium">Base UI</span>
      {officialDocs && <a href={officialDocs} target="_blank" rel="noreferrer" class="pb-3 text-muted-foreground hover:text-foreground">공식 문서 ↗</a>}
    </div>

    <section id="preview" class="scroll-mt-24">
      <h2 class="sr-only">미리보기</h2>
      {isLearning && (
        <p class="mb-4 text-sm leading-6 text-muted-foreground">
          아래에서 활동을 직접 진행해 보세요. 확인·제출 뒤에는 <span class="font-medium text-foreground">초기화</span>로 처음부터 다시 만져볼 수 있습니다.
        </p>
      )}
      <ExampleShowcase slug={doc.slug} code={usageCode} isLearning={isLearning} featured />
    </section>

    <section id="preview-lab" class="scroll-mt-24 pt-16">
      <p class="text-sm font-medium text-muted-foreground">Preview lab</p>
      <h2 class="mt-2 font-heading text-2xl font-semibold tracking-tight">반응형 미리보기</h2>
      <p class="mt-3 max-w-2xl leading-7 text-muted-foreground">
        테마, 모션과 5개 기준 뷰포트를 바꾸며 격리된 브라우저 문맥에서 확인합니다.
      </p>
      {guide.examples[0]?.preview !== false && (
        <div class="mt-6">
          <ResponsivePreview
            src={`${baseUrl}preview/components/${doc.slug}/${guide.examples[0].id}`}
            title={`${doc.title} ${guide.examples[0].title} 미리보기`}
            client:load
          />
        </div>
      )}
    </section>

    <section id="usage" class="scroll-mt-24 pt-16">
      <p class="text-sm font-medium text-muted-foreground">Usage</p>
      <h2 class="mt-2 font-heading text-2xl font-semibold tracking-tight">가져오기</h2>
      <p class="mt-3 leading-7 text-muted-foreground">모노레포 workspace 패키지 <code class="rounded-lg bg-muted px-1.5 py-0.5 text-foreground">@workspace/ui</code>에서 컴포넌트를 가져옵니다.</p>
      <div class="mt-6"><CodeBlock code={installCommand} label="Import" client:load /></div>
      <div class="mt-6"><CodeBlock code={usageCode} client:load /></div>
      <details class="mt-4 overflow-hidden rounded-3xl border bg-muted/20">
        <summary class="cursor-pointer px-5 py-4 text-sm font-medium">패키지 소스</summary>
        <div class="border-t">
          <CodeBlock code={source} label={`${doc.slug}.tsx`} joined client:load />
        </div>
      </details>
    </section>

    <div class="pt-4">
      {guide.examples.map((example, index) => (
        <section id={example.id} class="scroll-mt-24 pt-16">
          <p class="text-sm font-medium text-muted-foreground">{index === 0 ? "Examples" : `Example ${index + 1}`}</p>
          <h2 class="mt-2 font-heading text-2xl font-semibold tracking-tight">{example.title}</h2>
          <p class="mt-3 max-w-2xl leading-7 text-muted-foreground">{example.description}</p>
          {example.preview !== false && (
            <div class="mt-6">
              <ExampleShowcase
                slug={doc.slug}
                example={example.id}
                code={example.code}
                isLearning={isLearning}
              />
            </div>
          )}
          {example.preview === false && (
            <div class="mt-5"><CodeBlock code={example.code} label="TSX" client:load /></div>
          )}
          {example.note && (
            <div class="mt-4 rounded-3xl border border-dashed px-5 py-4 text-sm leading-6 text-muted-foreground">
              <span class="mr-2 font-medium text-foreground">유의사항</span>{example.note}
            </div>
          )}
        </section>
      ))}
    </div>

    <MigratedComponentStories
      slug={doc.slug}
      stories={migratedStories}
      guide={guide}
      isLearning={isLearning}
    />

    <section id="usage-guidelines" class="scroll-mt-24 pt-16">
      <p class="text-sm font-medium text-muted-foreground">Guidelines</p>
      <h2 class="mt-2 font-heading text-2xl font-semibold tracking-tight">사용 지침</h2>
      <p class="mt-3 max-w-2xl leading-7 text-muted-foreground">{guide.summary}</p>
      <ul class="mt-6 grid gap-3">
        {guide.usageNotes.map((note) => (
          <li class="flex gap-3 rounded-3xl bg-muted/35 px-5 py-4 text-sm leading-6">
            <span aria-hidden="true" class="mt-2 size-1.5 shrink-0 rounded-full bg-foreground/55"></span>
            <span>{note}</span>
          </li>
        ))}
      </ul>
      {guide.related && guide.related.length > 0 && (
        <div class="mt-6 flex flex-wrap items-center gap-2">
          <span class="mr-1 text-xs font-medium text-muted-foreground">함께 사용하기</span>
          {guide.related.map((relatedSlug) => {
            const related = componentDocs.find((component) => component.slug === relatedSlug)
            return related && (
              <a href={`${baseUrl}docs/components/${related.slug}`} class="rounded-full border px-3 py-1.5 text-xs font-medium hover:bg-muted">
                {related.title}
              </a>
            )
          })}
        </div>
      )}
    </section>

    <section id="accessibility" class="scroll-mt-24 pt-16">
      <p class="text-sm font-medium text-muted-foreground">Accessibility</p>
      <h2 class="mt-2 font-heading text-2xl font-semibold tracking-tight">접근성</h2>
      <div class="mt-6 rounded-4xl border p-6 sm:p-7">
        <ol class="grid gap-4">
          {guide.accessibility.map((item, index) => (
            <li class="grid grid-cols-[2rem_1fr] gap-2 text-sm leading-6">
              <span class="grid size-7 place-items-center rounded-full bg-muted font-mono text-[11px] text-muted-foreground">{index + 1}</span>
              <span>{item}</span>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section id="props" class="scroll-mt-24 pt-16">
      <p class="text-sm font-medium text-muted-foreground">API</p>
      <h2 class="mt-2 font-heading text-2xl font-semibold tracking-tight">Props</h2>
      <p class="mt-3 leading-7 text-muted-foreground">아래는 자주 사용하는 공개 Props입니다. 그 외 HTML 속성과 Base UI primitive Props도 전달할 수 있습니다.</p>
      <div class="mt-6 overflow-hidden rounded-3xl border">
        <div class="overflow-x-auto">
          <table class="w-full min-w-150 text-left text-sm">
            <thead class="bg-muted/55 text-xs text-muted-foreground">
              <tr><th class="px-4 py-3 font-medium">Prop</th><th class="px-4 py-3 font-medium">Type</th><th class="px-4 py-3 font-medium">Default</th><th class="px-4 py-3 font-medium">설명</th></tr>
            </thead>
            <tbody class="divide-y">
              {props.map((prop) => (
                <tr>
                  <td class="px-4 py-3 align-top font-mono text-xs font-medium">{prop.name}</td>
                  <td class="px-4 py-3 align-top font-mono text-xs text-muted-foreground">{prop.type}</td>
                  <td class="px-4 py-3 align-top font-mono text-xs text-muted-foreground">{prop.defaultValue}</td>
                  <td class="px-4 py-3 leading-6 text-muted-foreground">{prop.description}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <section id="api-reference" class="scroll-mt-24 pt-16">
      <p class="text-sm font-medium text-muted-foreground">Exports</p>
      <h2 class="mt-2 font-heading text-2xl font-semibold tracking-tight">API Reference</h2>
      <p class="mt-3 leading-7 text-muted-foreground">현재 레지스트리 소스에서 실제로 내보내는 컴포넌트 목록입니다.</p>
      <div class="mt-6 grid gap-2 sm:grid-cols-2">
        {exports.map((name) => (
          <div class="flex items-center justify-between rounded-2xl border px-4 py-3">
            <code class="text-xs font-medium">{name}</code>
            <span class="text-[11px] text-muted-foreground">React component</span>
          </div>
        ))}
      </div>
      <div class="mt-6 flex flex-wrap gap-3">
        {officialDocs && <a href={officialDocs} target="_blank" rel="noreferrer" class="rounded-2xl border px-4 py-2 text-sm font-medium hover:bg-muted">shadcn 공식 문서</a>}
        {apiReference && <a href={apiReference} target="_blank" rel="noreferrer" class="rounded-2xl border px-4 py-2 text-sm font-medium hover:bg-muted">Primitive API</a>}
        <a href={`${baseUrl}r/${doc.slug}.json`} class="rounded-2xl border px-4 py-2 text-sm font-medium hover:bg-muted">Registry JSON</a>
      </div>
    </section>

    <nav class="mt-20 grid gap-3 border-t pt-8 sm:grid-cols-2" aria-label="이전 및 다음 컴포넌트">
      {previous ? <a href={`${baseUrl}docs/components/${previous.slug}`} class="rounded-3xl border p-5 hover:bg-muted/50"><span class="text-xs text-muted-foreground">이전</span><span class="mt-1 block font-medium">← {previous.title}</span></a> : <span />}
      {next && <a href={`${baseUrl}docs/components/${next.slug}`} class="rounded-3xl border p-5 text-right hover:bg-muted/50"><span class="text-xs text-muted-foreground">다음</span><span class="mt-1 block font-medium">{next.title} →</span></a>}
    </nav>
  </article>
</DocsLayout>

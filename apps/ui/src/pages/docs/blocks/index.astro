---
import SiteHeader from "@/src/components/site-header.astro"
import ThemeInitializer from "@/src/components/theme-initializer.astro"
import BlocksCatalog from "@/src/components/blocks-catalog"
import { blockSections } from "@/src/lib/block-docs"
import { getBlockSource } from "@/src/lib/block-source"
import { getInstallCommand } from "@/src/lib/component-docs"
import "@/src/styles/global.css"

const title = "블록"
const description =
  "로그인·학습·운영 홈 등 완성된 화면 구성을 registry:block으로 제공합니다."
const baseUrl = import.meta.env.BASE_URL
const pageTitle = `${title} — Luma UI`

const sections = blockSections.map((section) =>
  Object.assign({}, section, {
    blocks: section.blocks.map((block) =>
      Object.assign({}, block, {
        installCommand: getInstallCommand(block.installName),
        code: getBlockSource(block.slug),
      }),
    ),
  }),
)
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f9f8f5" />
    <ThemeInitializer />
    <link rel="icon" type="image/svg+xml" href={`${baseUrl}favicon.svg`} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <div class="site-root min-h-svh">
      <SiteHeader active="blocks" />

      <main class="mx-auto max-w-6xl px-5 py-12 lg:px-8 lg:py-16">
        <header class="max-w-2xl">
          <p class="text-sm font-medium tracking-[0.04em] text-muted-foreground uppercase">
            Blocks
          </p>
          <h1 class="mt-3 font-heading text-4xl font-semibold tracking-[-0.04em] text-balance sm:text-5xl">
            블록
          </h1>
          <p class="mt-4 text-base leading-7 text-pretty text-muted-foreground sm:text-lg sm:leading-8">
            라우트에 바로 붙여 쓸 수 있는 화면 단위 구성입니다. 학습, 운영, 로그인 탭에서 용도에 맞는 블록을 살펴보세요.
          </p>
        </header>

        <BlocksCatalog client:only="react" sections={sections} />
      </main>
    </div>
  </body>
</html>

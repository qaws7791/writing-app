---
import WorkspaceExtensionContent from "@/src/components/workspace-extension-content.astro"
import DocsLayout from "@/src/layouts/docs-layout.astro"
import { workspaceExtensionDocs, type WorkspaceExtensionDoc } from "@/src/lib/workspace-extension-docs"

export function getStaticPaths() {
  return workspaceExtensionDocs.filter((doc) => doc.slug !== "theme-selector").map((doc) => ({ params: { slug: doc.slug }, props: { doc } }))
}

type Props = { doc: WorkspaceExtensionDoc }
const { doc } = Astro.props
const toc = [{ id: "responsive-preview", label: "반응형 미리보기" }, { id: "states", label: "실행 상태" }, { id: "props", label: "Props" }, { id: "guidelines", label: "사용 지침" }, { id: "accessibility", label: "접근성" }]
---

<DocsLayout title={doc.title} description={doc.description} pathname={`/docs/extensions/lesson/${doc.slug}`} toc={toc}>
  <WorkspaceExtensionContent doc={doc} />
</DocsLayout>

      "css": {
        "@import \"tw-animate-css\"": {},
        "@import \"shadcn/tailwind.css\"": {},
        "@import \"pretendard/dist/web/variable/pretendardvariable-dynamic-subset.css\"": {},
        "@keyframes breathe": {
          "0%, 100%": { "opacity": "1" },
          "50%": { "opacity": "0.55" }
        },
        "@keyframes drift-in": {
          "from": { "opacity": "0", "transform": "translateY(4px)" },
          "to": { "opacity": "1", "transform": "none" }
        },
        "@utility squircle": {
          "@supports (corner-shape: squircle)": { "corner-shape": "squircle" }
        },
        "@utility squircle-soft": {
          "@supports (corner-shape: superellipse(1.5))": { "corner-shape": "superellipse(1.5)" }
        },
        "@layer base": {
          "*": { "@apply border-border outline-ring/50": {} },
          "body": { "@apply bg-background text-foreground antialiased": {} },
          "html": { "@apply font-sans": {} },
          "::selection": { "@apply bg-selection text-selection-foreground": {} },
          "th, td, time, kbd": { "font-variant-numeric": "tabular-nums" },
          "@media (prefers-reduced-motion: reduce)": {
            "*, ::before, ::after": {
              "animation-duration": "0.01ms !important",
              "animation-iteration-count": "1 !important",
              "transition-duration": "0.01ms !important"
            }
          }
        }

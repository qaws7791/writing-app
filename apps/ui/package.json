{
  "name": "@workspace/ui-docs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run docs:generate-previews && astro dev",
    "build": "bun run docs:generate-previews && astro check && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "bun run docs:generate-previews && astro check",
    "typecheck": "bun run check",
    "lint": "oxlint --deny-warnings .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "docs:validate": "bun scripts/validate-docs.ts",
    "docs:generate-previews": "bun scripts/generate-doc-previews.ts",
    "test:browser": "playwright test --config playwright.config.ts",
    "audit": "bun audit",
    "verify": "bun run format:check && bun run lint && bun run docs:validate && bun run check && bun run build"
  },
  "dependencies": {
    "@hugeicons/core-free-icons": "catalog:",
    "@hugeicons/react": "catalog:",
    "@workspace/ui": "workspace:*",
    "input-otp": "catalog:",
    "react": "catalog:",
    "react-day-picker": "catalog:",
    "react-dom": "catalog:",
    "recharts": "catalog:"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@astrojs/check": "0.9.10",
    "@astrojs/react": "6.0.2",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "astro": "7.1.6",
    "axe-core": "4.12.1",
    "oxlint": "catalog:",
    "shadcn": "4.16.1",
    "tailwindcss": "catalog:",
    "tw-animate-css": "catalog:",
    "typescript": "catalog:"
  }
}

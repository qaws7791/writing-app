{
  "name": "ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run docs:generate-previews && astro dev",
    "build": "bun run registry:build && bun run docs:generate-previews && astro check && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "bun run docs:generate-previews && astro check",
    "lint": "oxlint --deny-warnings .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "docs:validate": "bun scripts/validate-docs.ts",
    "docs:generate-previews": "bun scripts/generate-doc-previews.ts",
    "registry:build": "shadcn build registry.json -o public/r",
    "registry:validate": "shadcn registry validate registry.json",
    "audit": "bun audit",
    "verify": "bun run format:check && bun run lint && bun run docs:validate && bun run check && bun run registry:validate && bun run build"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@dnd-kit/dom": "^0.5.0",
    "@dnd-kit/react": "^0.5.0",
    "@hugeicons/core-free-icons": "^4.2.3",
    "@hugeicons/react": "^1.1.9",
    "@shadcn/react": "^0.2.1",
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "input-otp": "^1.4.2",
    "pretendard": "^1.3.9",
    "react": "^19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.8",
    "recharts": "3.8.0",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/react": "^6.0.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "astro": "^7.1.6",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.76.0",
    "shadcn": "^4.16.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.0"
  },
  "engines": {
    "bun": ">=1.3.14"
  },
  "packageManager": "bun@1.3.14"
}

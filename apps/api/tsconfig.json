{
  "extends": "@workspace/typescript-config/base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "paths": {
      "#ai/*": ["../../packages/infra/ai/src/*"],
      "#auth/*": ["../../packages/infra/auth/src/*"],
      "#content/*": ["../../packages/modules/content/src/*"],
      "#db/*": ["../../packages/infra/db/src/*"],
      "#env/*": ["../../packages/config/env/src/*"],
      "#http-platform/*": ["../../packages/infra/http-platform/src/*"],
      "#identity/*": ["../../packages/modules/identity/src/*"],
      "#learning/*": ["../../packages/modules/learning/src/*"],
      "#observability/*": ["../../packages/infra/observability/src/*"],
      "#operations/*": ["../../packages/modules/operations/src/*"],
      "#writing/*": ["../../packages/modules/writing/src/*"],
      "@/*": ["./src/*"]
    },
    "types": ["bun"]
  },
  "include": ["src/**/*.ts", "vitest.config.ts"],
  "exclude": ["node_modules", "dist"]
}

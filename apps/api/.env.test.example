NODE_ENV=test
DEPLOYMENT_ENVIRONMENT=test
API_PORT=4000
DATABASE_URL=:memory:
DEPLOYMENT_VERSION=test
WEB_ORIGIN=http://localhost:3000
ADMIN_ORIGIN=http://localhost:3001
LEARNER_AUTH_SECRET=replace-with-distinct-32-byte-test-learner-secret
CURSOR_SIGNING_SECRET=replace-with-distinct-32-byte-test-cursor-secret
ADMIN_AUTH_SECRET=replace-with-distinct-32-byte-test-admin-secret
OPENAI_MODEL=gpt-5.2
# 일일 quota 수치는 제품 entitlement가 아닌 출시 검증 전 운영 safeguard 예시다.
AI_FEEDBACK_USER_DAILY_REQUEST_LIMIT=20
AI_FEEDBACK_USER_DAILY_SUCCESS_LIMIT=10
AI_FEEDBACK_GLOBAL_DAILY_REQUEST_LIMIT=1000
AI_FEEDBACK_GLOBAL_DAILY_SUCCESS_LIMIT=500
AI_FEEDBACK_PROVIDER_TIMEOUT_MS=30000
AI_FEEDBACK_PENDING_TTL_MS=60000
ADMIN_MCP_ENABLED=false
ADMIN_MCP_CHANGES_ENABLED=false

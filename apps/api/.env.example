BETTER_AUTH_SECRET=replace-with-32-byte-local-api-secret
CURSOR_SIGNING_SECRET=replace-with-distinct-32-byte-cursor-secret
BETTER_AUTH_URL=http://localhost:4000
# production에서는 아래 관리자 값도 별도 고 entropy 값과 HTTPS URL로 필수다.
# ADMIN_BETTER_AUTH_SECRET=replace-with-distinct-production-admin-secret
# ADMIN_BETTER_AUTH_URL=https://admin-api.example.com
# ADMIN_ORIGIN=https://admin.example.com
# BETTER_AUTH_COOKIE_DOMAIN=example.com
DATABASE_URL=file:data/api.sqlite
NODE_ENV=development
DEPLOYMENT_VERSION=local
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
ENABLE_TEST_AUTH=true
# OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-5.2

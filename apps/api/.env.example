LEARNER_AUTH_SECRET=replace-with-32-byte-local-learner-secret
ADMIN_AUTH_SECRET=replace-with-distinct-32-byte-admin-secret
CURSOR_SIGNING_SECRET=replace-with-distinct-32-byte-cursor-secret
API_ORIGIN=http://localhost:4000
API_ALLOWED_HOSTS=localhost:4000,api:4000
ADMIN_ORIGIN=http://localhost:3001
# LEARNER_AUTH_COOKIE_DOMAIN=example.com
# ADMIN_AUTH_COOKIE_DOMAIN=example.com
DATABASE_URL=file:data/api.sqlite
NODE_ENV=development
DEPLOYMENT_VERSION=local
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
ENABLE_TEST_AUTH=true
ADMIN_SEED_EMAIL=owner@example.com
ADMIN_SEED_NAME=관리자
ADMIN_SEED_PASSWORD=replace-with-strong-local-admin-password
ADMIN_SEED_RESET_PASSWORD=true
# 운영 seed에만 아래 두 값을 명시하고 DATABASE_URL과 정확히 일치시킨다.
# ADMIN_SEED_PRODUCTION_APPROVED=true
# ADMIN_SEED_EXPECTED_DATABASE_URL=file:/absolute/path/to/api.sqlite
# 운영 기준 콘텐츠 seed에만 아래 두 값을 명시하고 DATABASE_URL과 정확히 일치시킨다.
# DATABASE_SEED_PRODUCTION_APPROVED=true
# DATABASE_SEED_EXPECTED_DATABASE_URL=file:/absolute/path/to/api.sqlite
# ADMIN_ASSET_S3_ACCESS_KEY=replace-with-r2-access-key
# ADMIN_ASSET_S3_SECRET_KEY=replace-with-r2-secret-key
# ADMIN_ASSET_S3_BUCKET=writing-app-assets
# ADMIN_ASSET_S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# ADMIN_ASSET_S3_REGION=auto
# ADMIN_ASSET_PUBLIC_BASE_URL=https://assets.example.com
# OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-5.2
# GOOGLE_CLIENT_ID=replace-with-google-client-id
# GOOGLE_CLIENT_SECRET=replace-with-google-client-secret

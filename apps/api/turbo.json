{
  "extends": ["//"],
  "tasks": {
    "db:migrate": {
      "passThroughEnv": ["NODE_ENV"]
    },
    "db:seed": {
      "passThroughEnv": ["NODE_ENV"]
    },
    "dev": {
      "passThroughEnv": [
        "ADMIN_AUTH_SECRET",
        "ADMIN_ORIGIN",
        "ADMIN_SEED_EMAIL",
        "ADMIN_SEED_NAME",
        "ADMIN_SEED_PASSWORD",
        "ADMIN_SEED_RESET_PASSWORD",
        "API_PORT",
        "ASSET_PUBLIC_BASE_URL",
        "AUTH_EMAIL_FROM",
        "AUTH_EMAIL_REPLY_TO",
        "CURSOR_SIGNING_SECRET",
        "DEPLOYMENT_ENVIRONMENT",
        "DEPLOYMENT_VERSION",
        "ENABLE_API_DOCS",
        "GOOGLE_CLIENT_ID",
        "GOOGLE_CLIENT_SECRET",
        "LEARNER_AUTH_SECRET",
        "LEARNER_DELETION_RETENTION_DAYS",
        "LOG_LEVEL",
        "NODE_ENV",
        "WEB_ORIGIN",
        "WRITING_DAILY_SUCCESSFUL_CHECK_LIMIT"
      ]
    },
    "maintenance:daily": {
      "passThroughEnv": ["LEARNER_DELETION_RETENTION_DAYS", "NODE_ENV"]
    },
    "purge:deleted-learners": {
      "passThroughEnv": ["LEARNER_DELETION_RETENTION_DAYS", "NODE_ENV"]
    },
    "restore:deletion-markers": {
      "passThroughEnv": ["LEARNER_DELETION_RETENTION_DAYS", "NODE_ENV"]
    }
  }
}

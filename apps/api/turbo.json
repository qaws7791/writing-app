{
  "extends": ["//"],
  "tasks": {
    "db:backup": {
      "passThroughEnv": ["DATABASE_URL"]
    },
    "db:migrate": {
      "passThroughEnv": ["DATABASE_URL"]
    },
    "db:reset": {
      "passThroughEnv": [
        "ALLOW_DATABASE_RESET",
        "DATABASE_RESET_TARGET_FINGERPRINT",
        "DATABASE_URL",
        "NODE_ENV"
      ]
    },
    "db:seed": {
      "passThroughEnv": ["ALLOW_DATABASE_RESET", "DATABASE_URL", "NODE_ENV"]
    },
    "dev": {
      "passThroughEnv": [
        "ADMIN_AUTH_SECRET",
        "ADMIN_ORIGIN",
        "ADMIN_AUDIT_APPROVED_ADMINS_JSON",
        "ADMIN_SESSION_EXPECTED_DATABASE_URL",
        "ADMIN_SESSION_REVOCATION_APPROVED",
        "API_PORT",
        "CURSOR_SIGNING_SECRET",
        "DATABASE_URL",
        "ENABLE_TEST_AUTH",
        "GOOGLE_CLIENT_ID",
        "GOOGLE_CLIENT_SECRET",
        "LEARNER_AUTH_SECRET",
        "LOG_PRETTY",
        "NODE_ENV",
        "OPENAI_API_KEY",
        "OPENAI_MODEL",
        "WEB_ORIGIN"
      ]
    }
  }
}

NODE_ENV=production
DEPLOYMENT_ENVIRONMENT=staging
ENABLE_API_DOCS=true
API_PORT=4000
DATABASE_URL=file:/var/lib/writing-app/api.sqlite
DEPLOYMENT_VERSION=replace-with-staging-api-image-digest
WEB_ORIGIN=https://staging-app.example.com
ADMIN_ORIGIN=https://staging-admin.example.com
LEARNER_AUTH_SECRET=replace-with-staging-learner-auth-secret
CURSOR_SIGNING_SECRET=replace-with-distinct-staging-cursor-secret
ADMIN_AUTH_SECRET=replace-with-distinct-staging-admin-auth-secret
GOOGLE_CLIENT_ID=replace-with-staging-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-staging-google-client-secret
RESEND_API_KEY=replace-with-staging-resend-api-key
AUTH_EMAIL_FROM=글결 Staging <auth-staging@example.com>
AUTH_EMAIL_REPLY_TO=support-staging@example.com
OPENAI_API_KEY=replace-with-staging-openai-api-key
OPENAI_MODEL=gpt-5.2
# 일일 quota 수치는 제품 entitlement가 아닌 출시 검증 전 운영 safeguard 예시다.
AI_FEEDBACK_USER_DAILY_REQUEST_LIMIT=20
AI_FEEDBACK_USER_DAILY_SUCCESS_LIMIT=10
AI_FEEDBACK_GLOBAL_DAILY_REQUEST_LIMIT=1000
AI_FEEDBACK_GLOBAL_DAILY_SUCCESS_LIMIT=500
AI_FEEDBACK_PROVIDER_TIMEOUT_MS=30000
AI_FEEDBACK_PENDING_TTL_MS=60000
ADMIN_ASSET_S3_ACCESS_KEY=replace-with-staging-public-asset-access-key
ADMIN_ASSET_S3_SECRET_KEY=replace-with-staging-public-asset-secret-key
ADMIN_ASSET_S3_BUCKET=replace-with-staging-public-asset-bucket
ADMIN_ASSET_S3_ENDPOINT=https://replace-with-staging-s3-endpoint
ADMIN_ASSET_S3_REGION=auto
ADMIN_ASSET_PUBLIC_BASE_URL=https://staging-assets.example.com
DELETION_MARKER_S3_ACCESS_KEY=replace-with-staging-private-marker-access-key
DELETION_MARKER_S3_SECRET_KEY=replace-with-staging-private-marker-secret-key
DELETION_MARKER_S3_BUCKET=replace-with-staging-private-marker-bucket
DELETION_MARKER_S3_ENDPOINT=https://replace-with-staging-private-s3-endpoint
DELETION_MARKER_S3_REGION=auto
DELETION_MARKER_S3_PREFIX=privacy/staging/deletion-markers

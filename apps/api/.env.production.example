NODE_ENV=production
DEPLOYMENT_ENVIRONMENT=production
ENABLE_API_DOCS=false
API_PORT=4000
DATABASE_URL=file:/var/lib/writing-app/api.sqlite
DEPLOYMENT_VERSION=replace-with-production-api-image-digest
WEB_ORIGIN=https://app.example.com
ADMIN_ORIGIN=https://admin.example.com
LEARNER_AUTH_SECRET=replace-with-production-learner-auth-secret
CURSOR_SIGNING_SECRET=replace-with-distinct-production-cursor-secret
ADMIN_AUTH_SECRET=replace-with-distinct-production-admin-auth-secret
GOOGLE_CLIENT_ID=replace-with-production-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-production-google-client-secret
OPENAI_API_KEY=replace-with-production-openai-api-key
OPENAI_MODEL=gpt-4.1-mini
WRITING_DAILY_SUCCESSFUL_CHECK_LIMIT=5
RESEND_API_KEY=replace-with-production-resend-api-key
AUTH_EMAIL_FROM=글결 <auth@example.com>
AUTH_EMAIL_REPLY_TO=support@example.com
ADMIN_ASSET_S3_ACCESS_KEY=replace-with-production-public-asset-access-key
ADMIN_ASSET_S3_SECRET_KEY=replace-with-production-public-asset-secret-key
ADMIN_ASSET_S3_BUCKET=replace-with-production-public-asset-bucket
ADMIN_ASSET_S3_ENDPOINT=https://replace-with-production-s3-endpoint
ADMIN_ASSET_S3_REGION=auto
ADMIN_ASSET_PUBLIC_BASE_URL=https://assets.example.com
DELETION_MARKER_S3_ACCESS_KEY=replace-with-production-private-marker-access-key
DELETION_MARKER_S3_SECRET_KEY=replace-with-production-private-marker-secret-key
DELETION_MARKER_S3_BUCKET=replace-with-production-private-marker-bucket
DELETION_MARKER_S3_ENDPOINT=https://replace-with-production-private-s3-endpoint
DELETION_MARKER_S3_REGION=auto
DELETION_MARKER_S3_PREFIX=privacy/production/deletion-markers
ADMIN_MCP_ENABLED=false
ADMIN_MCP_CHANGES_ENABLED=false

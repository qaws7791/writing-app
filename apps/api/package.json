{
  "name": "@workspace/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cd ../.. && bun --env-file=apps/api/.env --watch apps/api/src/main.ts",
    "start": "bun src/main.ts",
    "lint": "oxlint .",
    "test": "bun --bun ../../node_modules/vitest/vitest.mjs run --config vitest.config.ts",
    "test:watch": "bun --bun ../../node_modules/vitest/vitest.mjs watch --config vitest.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/zod-openapi": "^1.4.0",
    "@workspace/contracts": "workspace:*",
    "@workspace/core": "workspace:*",
    "@workspace/env": "workspace:*",
    "@workspace/hono": "workspace:*",
    "@workspace/logger": "workspace:*",
    "hono": "^4.12.25",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@workspace/config": "workspace:*",
    "@workspace/repository-tooling": "workspace:*",
    "typescript": "5.9.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "catalog:"
  }
}

{
  "name": "@workspace/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "audit:admin-auth": "cd ../.. && tsx --tsconfig apps/api/tsconfig.json --env-file=apps/api/.dev.vars apps/api/src/scripts/admin-auth-audit.ts",
    "build": "wrangler deploy --dry-run --outdir dist",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "db:inspect": "wrangler d1 execute DB --local --command \"PRAGMA quick_check\"",
    "db:seed": "cd ../.. && tsx --tsconfig apps/api/tsconfig.json --env-file=apps/api/.dev.vars apps/api/src/scripts/seed-database.ts",
    "dev": "wrangler dev --local",
    "generate": "bun run openapi:generate",
    "start": "wrangler dev --local",
    "lint": "oxlint .",
    "openapi:generate": "cd ../.. && bun apps/api/src/scripts/generate-openapi.ts",
    "maintenance:daily": "cd ../.. && tsx --tsconfig apps/api/tsconfig.json --env-file=apps/api/.dev.vars apps/api/src/scripts/maintenance-daily.ts",
    "purge:deleted-learners": "cd ../.. && tsx --tsconfig apps/api/tsconfig.json --env-file=apps/api/.dev.vars apps/api/src/scripts/purge-deleted-learners.ts",
    "revoke:admin-sessions": "cd ../.. && tsx --tsconfig apps/api/tsconfig.json --env-file=apps/api/.dev.vars apps/api/src/scripts/revoke-admin-sessions.ts",
    "restore:deletion-markers": "cd ../.. && tsx --tsconfig apps/api/tsconfig.json --env-file=apps/api/.dev.vars apps/api/src/scripts/reapply-deletion-markers.ts",
    "seed:admin": "cd ../.. && tsx --tsconfig apps/api/tsconfig.json --env-file=apps/api/.dev.vars apps/api/src/scripts/seed-admin.ts",
    "test": "node ../../node_modules/vitest/vitest.mjs run --config vitest.config.ts",
    "typecheck": "tsc7 --noEmit"
  },
  "dependencies": {
    "@hono/zod-openapi": "catalog:",
    "@scalar/hono-api-reference": "catalog:",
    "@workspace/auth": "workspace:*",
    "@workspace/content": "workspace:*",
    "@workspace/contracts": "workspace:*",
    "@workspace/db": "workspace:*",
    "@workspace/env": "workspace:*",
    "@workspace/http-platform": "workspace:*",
    "@workspace/identity": "workspace:*",
    "@workspace/kernel": "workspace:*",
    "@workspace/learning": "workspace:*",
    "@workspace/observability": "workspace:*",
    "@workspace/operations": "workspace:*",
    "@workspace/storage": "workspace:*",
    "@workspace/types": "workspace:*",
    "@workspace/writing": "workspace:*",
    "drizzle-orm": "catalog:",
    "hono": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@scalar/openapi-parser": "catalog:",
    "@types/bun": "catalog:",
    "@workspace/typescript-config": "workspace:*",
    "@workspace/vitest-config": "workspace:*",
    "typescript": "catalog:",
    "vite-tsconfig-paths": "catalog:",
    "vitest": "catalog:",
    "@cloudflare/workers-types": "catalog:",
    "wrangler": "catalog:",
    "tsx": "catalog:"
  }
}

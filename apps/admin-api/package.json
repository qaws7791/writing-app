{
  "name": "@workspace/admin-api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit",
    "dev": "cd ../.. && bun --no-clear-screen --env-file=apps/admin-api/.env --preload ./apps/admin-api/src/dev-environment.ts --watch apps/admin-api/src/main.ts",
    "start": "bun src/main.ts",
    "audit:admin-auth": "bun src/scripts/admin-auth-audit.ts",
    "lint": "oxlint .",
    "revoke:admin-sessions": "bun src/scripts/revoke-admin-sessions.ts",
    "seed:admin": "bun src/scripts/seed-admin.ts",
    "test": "bun --bun ../../node_modules/vitest/vitest.mjs run --config vitest.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1088.0",
    "@hono/zod-openapi": "^1.4.0",
    "@mastra/core": "^1.46.0",
    "@workspace/contracts": "workspace:*",
    "@workspace/core": "workspace:*",
    "@workspace/db": "workspace:*",
    "@workspace/env": "workspace:*",
    "@workspace/hono": "workspace:*",
    "@workspace/logger": "workspace:*",
    "better-auth": "^1.6.13",
    "drizzle-orm": "^0.45.0",
    "hono": "^4.12.25",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@better-auth/utils": "catalog:",
    "@types/bun": "catalog:",
    "@workspace/config": "workspace:*",
    "@workspace/repository-tooling": "workspace:*",
    "@workspace/resource-document": "workspace:*",
    "lexical": "0.46.0",
    "typescript": "5.9.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "catalog:"
  }
}

ADMIN_BETTER_AUTH_SECRET=replace-with-32-byte-local-admin-secret
ADMIN_BETTER_AUTH_URL=http://localhost:4001
# production에서는 비교 검증을 위해 학습자 값도 별도로 필수다.
# BETTER_AUTH_SECRET=replace-with-distinct-production-learner-secret
# BETTER_AUTH_URL=https://api.example.com
# WEB_ORIGIN=https://app.example.com
# ADMIN_BETTER_AUTH_COOKIE_DOMAIN=example.com
DATABASE_URL=file:../../data/api.sqlite
NODE_ENV=development
ADMIN_API_PORT=4001
ADMIN_ORIGIN=http://localhost:3001
ADMIN_SEED_EMAIL=owner@example.com
ADMIN_SEED_NAME=관리자
ADMIN_SEED_PASSWORD=replace-with-strong-local-admin-password
ADMIN_SEED_RESET_PASSWORD=true
# 운영 seed에만 아래 두 값을 명시하고 DATABASE_URL과 정확히 일치시킨다.
# ADMIN_SEED_PRODUCTION_APPROVED=true
# ADMIN_SEED_EXPECTED_DATABASE_URL=file:/absolute/path/to/admin.sqlite

# 운영 R2 endpoint는 https://<ACCOUNT_ID>.r2.cloudflarestorage.com 형식입니다.
ADMIN_ASSET_S3_ENDPOINT=http://localhost:9000
ADMIN_ASSET_S3_REGION=us-east-1
ADMIN_ASSET_S3_BUCKET=writing-app-public-assets
ADMIN_ASSET_PUBLIC_BASE_URL=http://localhost:9000/writing-app-public-assets
ADMIN_ASSET_S3_ACCESS_KEY=replace-with-r2-access-key-id
ADMIN_ASSET_S3_SECRET_KEY=replace-with-r2-secret-access-key
# GOOGLE_CLIENT_ID=replace-with-google-client-id
# GOOGLE_CLIENT_SECRET=replace-with-google-client-secret

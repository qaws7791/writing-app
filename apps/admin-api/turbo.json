{
  "extends": ["//"],
  "tasks": {
    "audit:admin-auth": {
      "passThroughEnv": ["ADMIN_AUDIT_APPROVED_ADMINS_JSON", "DATABASE_URL"]
    },
    "build": {
      "outputs": []
    },
    "dev": {
      "passThroughEnv": [
        "ADMIN_API_PORT",
        "ADMIN_BETTER_AUTH_COOKIE_DOMAIN",
        "ADMIN_BETTER_AUTH_SECRET",
        "ADMIN_BETTER_AUTH_URL",
        "ADMIN_CORS_ORIGIN",
        "ADMIN_ORIGIN",
        "BETTER_AUTH_COOKIE_DOMAIN",
        "BETTER_AUTH_SECRET",
        "BETTER_AUTH_URL",
        "DATABASE_URL",
        "LOG_PRETTY",
        "NODE_ENV",
        "OPENAI_API_KEY",
        "OPENAI_MODEL",
        "WEB_ORIGIN"
      ]
    },
    "revoke:admin-sessions": {
      "passThroughEnv": [
        "ADMIN_SESSION_EXPECTED_DATABASE_URL",
        "ADMIN_SESSION_REVOCATION_APPROVED",
        "DATABASE_URL"
      ]
    }
  }
}

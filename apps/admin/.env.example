# SQLite DB 파일 경로 (apps/api와 동일한 DB를 가리켜야 합니다)
DATABASE_URL=./data/geulpil.sqlite

# JWT 서명 비밀키 (32자 이상 랜덤 문자열)
ADMIN_JWT_SECRET=change-me-to-a-random-string-at-least-32-chars

# S3 호환 스토리지 (로컬: SeaweedFS, 프로덕션: AWS S3 등)
STORAGE_ENDPOINT=http://localhost:8333
STORAGE_ACCESS_KEY=local-access-key
STORAGE_SECRET_KEY=local-secret-key
STORAGE_BUCKET=writing-app-images
STORAGE_REGION=us-east-1
STORAGE_PUBLIC_URL=http://localhost:8333

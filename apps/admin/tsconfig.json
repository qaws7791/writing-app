{
  "extends": "@workspace/config/typescript/nextjs.json",
  "compilerOptions": {
    "baseUrl": ".",
    "incremental": true,
    "types": ["bun", "@testing-library/jest-dom"],
    "paths": {
      "@/components/ui/*": ["../../packages/ui/src/components/ui/*"],
      "@/hooks/*": ["../../packages/ui/src/hooks/*"],
      "@/lib/utils": ["../../packages/ui/src/lib/utils.ts"],
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": ["node_modules"]
}

{
  "extends": "@workspace/config/typescript/react-library.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "baseUrl": ".",
    "types": ["bun"],
    "paths": {
      "#ui/*": ["../../packages/ui/src/*"],
      "#storybook/*": ["src/*"],
      "#storybook-config/*": [".storybook/*"],
      "#storybook-root/*": ["*"]
    }
  },
  "include": [
    ".storybook/**/*.ts",
    ".storybook/**/*.tsx",
    "src/**/*.mdx",
    "src/**/*.ts",
    "src/**/*.tsx"
  ],
  "exclude": ["node_modules", "dist"]
}

{
  "name": "@workspace/storybook",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "imports": {
    "#storybook-config/preview": "./.storybook/preview.tsx",
    "#storybook-config/storybook-theme": "./.storybook/storybook-theme.ts",
    "#storybook-config/viewports": "./.storybook/viewports.ts",
    "#storybook-root/styles.css": "./styles.css"
  },
  "scripts": {
    "dev": "storybook dev -p 6006 --ci",
    "build": "storybook build --output-dir dist",
    "serve": "bunx http-server dist -p 6007 -c-1",
    "build:serve": "storybook build --output-dir dist && bunx http-server dist -p 6007 -c-1",
    "lint": "oxlint .",
    "test:stories": "vitest run --config vitest.storybook.config.ts --project=storybook",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@headless-tree/core": "^1.7.0",
    "@headless-tree/react": "^1.7.0",
    "@workspace/ui": "workspace:*",
    "lucide-react": "^1.8.0",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "10.2.19",
    "@storybook/addon-docs": "10.2.19",
    "@storybook/addon-vitest": "10.2.19",
    "@storybook/react-vite": "10.2.19",
    "@tailwindcss/postcss": "catalog:",
    "@tailwindcss/typography": "^0.5.20",
    "@types/bun": "^1.3.10",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.3",
    "@vitest/browser-playwright": "4.1.10",
    "@workspace/config": "workspace:*",
    "react-docgen-typescript": "^2.4.0",
    "storybook": "10.2.19",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "catalog:"
  }
}

{
  "name": "writing-app",
  "version": "0.0.1",
  "private": true,
  "imports": {
    "#e2e/*": "./e2e/*.ts",
    "#playwright-config": "./playwright.config.ts",
    "#scripts/*": "./scripts/*.ts"
  },
  "catalog": {
    "@better-auth/utils": "0.4.2",
    "@types/bun": "1.3.10",
    "@tailwindcss/postcss": "4.1.18",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "3.9.2",
    "vitest": "4.1.10"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "audit:full": "bun audit --audit-level=high --ignore=GHSA-r5fr-rjxr-66jc --ignore=GHSA-fx2h-pf6j-xcff --ignore=GHSA-v2wj-q39q-566r --ignore=GHSA-p9ff-h696-f583 --ignore=GHSA-26hh-7cqf-hhc6 --ignore=GHSA-86j7-9j95-vpqj --ignore=GHSA-vmh5-mc38-953g --ignore=GHSA-vxpw-j846-p89q --ignore=GHSA-hm92-r4w5-c3mj --ignore=GHSA-3mfm-83xf-c92r --ignore=GHSA-2w6w-674q-4c4q --ignore=GHSA-xhpv-hc6g-r9c6 --ignore=GHSA-9cx6-37pm-9jff --ignore=GHSA-xjpj-3mr7-gcpf --ignore=GHSA-ph9p-34f9-6g65 --ignore=GHSA-96hv-2xvq-fx4p --ignore=GHSA-rf6f-7fwh-wjgh --ignore=GHSA-88fw-hqm2-52qc --ignore=GHSA-c2c7-rcm5-vvqj",
    "audit:production": "bun audit --audit-level=high --ignore=GHSA-r5fr-rjxr-66jc --ignore=GHSA-fx2h-pf6j-xcff --ignore=GHSA-v2wj-q39q-566r --ignore=GHSA-p9ff-h696-f583 --ignore=GHSA-26hh-7cqf-hhc6 --ignore=GHSA-86j7-9j95-vpqj --ignore=GHSA-vmh5-mc38-953g --ignore=GHSA-vxpw-j846-p89q --ignore=GHSA-hm92-r4w5-c3mj --ignore=GHSA-3mfm-83xf-c92r --ignore=GHSA-2w6w-674q-4c4q --ignore=GHSA-xhpv-hc6g-r9c6 --ignore=GHSA-9cx6-37pm-9jff --ignore=GHSA-xjpj-3mr7-gcpf --ignore=GHSA-ph9p-34f9-6g65 --ignore=GHSA-96hv-2xvq-fx4p --ignore=GHSA-rf6f-7fwh-wjgh --ignore=GHSA-88fw-hqm2-52qc --ignore=GHSA-c2c7-rcm5-vvqj",
    "build": "turbo build",
    "build-storybook": "bun --filter @workspace/storybook build",
    "check:api-contract": "bun scripts/check-api-contract.ts",
    "check:admin-chart-route-bundle": "bun scripts/check-admin-chart-route-bundle.ts",
    "check:components-config": "bun scripts/check-components-config.ts",
    "check:design-system-guardrails": "bun scripts/check-design-system-guardrails.ts",
    "check:document-drift": "bun scripts/check-document-drift.ts",
    "check:import-cycles": "bun scripts/check-import-cycles.ts",
    "check:localhost-literals": "bun scripts/check-localhost-literals.ts",
    "check:package-interfaces": "bun scripts/check-package-interfaces.ts",
    "check:landing-route-bundle": "bun scripts/check-landing-route-bundle.ts",
    "check:resource-route-bundle": "bun scripts/check-resource-route-bundle.ts",
    "check:toolchain": "bun scripts/check-toolchain.ts",
    "check:ui-style-compiled-css": "bun scripts/check-ui-style-compiled-css.ts",
    "check:workspace-inventory": "bun scripts/check-workspace-inventory.ts",
    "check:workspace-dependency-versions": "bun scripts/check-workspace-dependency-versions.ts",
    "dev": "turbo dev",
    "dev:admin": "bun run check:toolchain && turbo dev --filter=@workspace/admin --filter=@workspace/admin-api",
    "dev:admin:setup": "bun --filter @workspace/db db:migrate && bun --filter @workspace/db db:seed && bun --env-file=apps/admin-api/.env --filter @workspace/admin-api seed:admin",
    "dev:app": "turbo dev --filter=@workspace/web --filter=@workspace/api",
    "dev:app:setup": "bun --filter @workspace/db db:migrate && bun --filter @workspace/db db:seed",
    "dev:app:fresh": "bun run db:reset && bun run dev:app:setup && bun run dev:app",
    "db:backup": "bun packages/db/src/scripts/backup-database.ts",
    "db:reset": "bun --filter @workspace/db db:reset",
    "lint": "bun run check:toolchain && bun run check:workspace-inventory && bun run check:workspace-dependency-versions && bun run check:document-drift && bun run check:api-contract && bun run check:components-config && bun run check:design-system-guardrails && bun run check:import-cycles && bun run check:package-interfaces && bun run check:localhost-literals && oxlint apps packages scripts --deny-warnings",
    "lint:fix": "oxlint apps packages scripts --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "storybook": "bun --filter @workspace/storybook dev",
    "test": "turbo test",
    "test:admin-dev-lifecycle": "bun test ./scripts/admin-dev-lifecycle.test.ts",
    "test:e2e:resource-library-load": "bun --filter @workspace/core test:e2e:resource-library-load",
    "test:load:resource-library": "bun --filter @workspace/core test:load:resource-library",
    "test:coverage": "bun scripts/run-workspace-coverage.ts",
    "test:e2e": "bun scripts/run-e2e.ts",
    "test:e2e:ui-style": "playwright test --config playwright.ui-style.config.ts",
    "test:e2e:flaky-policy": "bun scripts/verify-playwright-flaky-policy.ts",
    "test:storybook": "bun --filter @workspace/storybook test:stories",
    "typecheck": "turbo typecheck",
    "prepare": "lefthook install",
    "repomix": "bun run repomix:code",
    "repomix:analysis": "bunx repomix --style markdown --output codebase-analysis.md --remove-empty-lines --include 'AGENTS.md,README.md,CONTEXT.md,ARCHITECTURE.md,DOMAIN.md,FRONTEND.md,BACKEND.md,GLOSSARY.md,docs/product/**/*.md,docs/design/**/*.md,docs/engineering/**/*.md,docs/engineering/contracts/**/*.json,packages/config/**,scripts/**,apps/storybook/**' --ignore 'prototype/**,.worktrees/**,codebase.md,codebase-analysis.md,combined-codebase-improvements.md,apps/storybook/dist/**,apps/storybook/.turbo/**,apps/storybook/build-output.log'",
    "repomix:code": "bunx repomix --style markdown --output codebase.md --remove-empty-lines --ignore 'sonnet-to-react, .agents, apps/storybook, docs, packages/config, scripts, prototype, .worktrees, codebase.md, codebase-analysis.md, combined-codebase-improvements.md'"
  },
  "devDependencies": {
    "@better-auth/utils": "catalog:",
    "@playwright/test": "^1.58.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.0",
    "@workspace/config": "workspace:*",
    "@workspace/repository-tooling": "workspace:*",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-turbo": "^2.8.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "jsdom": "^29.0.0",
    "lefthook": "^2.1.3",
    "oxfmt": "^0.55.0",
    "oxlint": "1.70.0",
    "turbo": "^2.8.8",
    "typescript": "5.9.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": "24.x"
  },
  "overrides": {
    "hono": "^4.12.25"
  },
  "packageManager": "bun@1.3.10"
}

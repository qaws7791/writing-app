{
  "name": "writing-app",
  "version": "0.0.1",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo build",
    "build-storybook": "bun --filter storybook build",
    "check:localhost-literals": "bun scripts/check-localhost-literals.ts",
    "dev": "turbo dev",
    "dev:admin": "bun run dev:admin:setup && turbo dev --filter=@workspace/admin --filter=@workspace/admin-api",
    "dev:admin:setup": "bun --filter @workspace/db db:seed && bun --filter @workspace/admin-api seed:admin",
    "dev:app": "turbo dev --filter=@workspace/web --filter=@workspace/api",
    "dev:app:setup": "bun --filter @workspace/db db:migrate && bun --filter @workspace/db db:seed",
    "dev:app:fresh": "bun run db:reset && bun run dev:app:setup && bun run dev:app",
    "db:reset": "bun --filter @workspace/db db:reset",
    "lint": "oxlint apps packages scripts",
    "lint:fix": "oxlint apps packages scripts --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "storybook": "bun --filter storybook dev",
    "test": "turbo test",
    "test:coverage": "node ./node_modules/vitest/vitest.mjs run --config vitest.workspace.ts --coverage",
    "typecheck": "turbo typecheck",
    "prepare": "lefthook install",
    "repomix": "bun run repomix:code",
    "repomix:analysis": "bunx repomix --style markdown --output codebase-analysis.md --remove-empty-lines --include 'AGENTS.md,README.md,CONTEXT.md,ARCHITECTURE.md,DOMAIN.md,FRONTEND.md,BACKEND.md,GLOSSARY.md,docs/*.md,docs/openapi/**/*.json,packages/config/**,scripts/**,apps/storybook/**' --ignore 'prototype/**,.worktrees/**,codebase.md,codebase-analysis.md,combined-codebase-improvements.md,apps/storybook/dist/**,apps/storybook/.turbo/**,apps/storybook/build-output.log'",
    "repomix:code": "bunx repomix --style markdown --output codebase.md --remove-empty-lines --ignore 'sonnet-to-react, .agents, apps/storybook, docs, packages/config, scripts, prototype, .worktrees, codebase.md, codebase-analysis.md, combined-codebase-improvements.md'"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.0",
    "@workspace/config": "workspace:*",
    "bun-types": "^1.3.11",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-turbo": "^2.8.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "jsdom": "^29.0.0",
    "lefthook": "^2.1.3",
    "oxfmt": "^0.55.0",
    "oxlint": "^1.70.0",
    "turbo": "^2.8.8",
    "typescript": "5.9.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.0"
  },
  "engines": {
    "node": "24.x"
  },
  "packageManager": "bun@1.3.10"
}
